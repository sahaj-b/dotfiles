#!/usr/bin/env bash

SUBDIRS=(frontend backend shared server client)

get_session_name() {
  local dir="$1"
  local base=$(basename "$dir")
  for sub in "${SUBDIRS[@]}"; do
    if [[ "$base" == "$sub" ]]; then
      local parent_dir=$(basename "$(dirname "$dir")")
      echo "${parent_dir}_${base}" | tr . _
      return
    fi
  done
  basename "$dir" | tr . _
}

existing_sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null)

# Build find filter and awk regex from the single SUBDIRS array
find_args=()
for sub in "${SUBDIRS[@]}"; do
  find_args+=(-name "$sub" -o)
done
unset 'find_args[${#find_args[@]}-1]'  # pop trailing -o

awk_regex=$(IFS='|'; echo "${SUBDIRS[*]}")

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(
    (
      find ~/projects -mindepth 1 -maxdepth 1 -type d
      find ~/projects -mindepth 2 -maxdepth 2 -type d \( "${find_args[@]}" \)
    ) | awk -v home="$HOME" -v sessions="$existing_sessions" -v subs="$awk_regex" '
    BEGIN {
      n = split(sessions, arr, "\n")
      for (i = 1; i <= n; i++) {
        sess[arr[i]] = 1
      }
      split(subs, subdirs, "|")
    }
    {
      dir = $0
      gsub(home, "~", dir)

      split($0, parts, "/")
      last = parts[length(parts)]
      matched = 0
      for (i in subdirs) {
        if (last == subdirs[i]) { matched = 1; break }
      }

      if (matched) {
        session_name = parts[length(parts)-1] "_" last
      } else {
        session_name = last
        gsub(/\./, "_", session_name)
      }

      if (sess[session_name]) {
        print "1\t● " dir
      } else {
        print "0\t  " dir
      }
    }
    ' | sort -k1,1nr -k2 | cut -f2- | fzf | sed 's/^[● ]* //'
  )
fi

if [[ -z $selected ]]; then
  exit 0
fi

selected_name=$(get_session_name "$selected")
selected=$(eval echo "$selected")
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  tmux new-session -s "$selected_name" -c "$selected"
  exit 0
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
fi

if [[ -z $TMUX ]]; then
  tmux attach-session -t "$selected_name"
else
  tmux switch-client -t "$selected_name"
fi
