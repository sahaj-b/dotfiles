#!/usr/bin/env bash
# pvm - Proton Version Manager (formerly geman)
# manage GE-Proton versions across steam and lutris roots
# https://github.com/GloriousEggroll/proton-ge-custom

set -euo pipefail

# --- paths ---
STEAM_HOME="$HOME/.local/share/Steam/compatibilitytools.d"
LUTRIS_HOME="$HOME/.local/share/lutris/runners/wine"
ACTIVE_PATH="$LUTRIS_HOME/ge-proton"

for d in "$STEAM_HOME" "$HOME/.steam/steam/compatibilitytools.d"; do
  [[ -d "$d" ]] && STEAM_ROOT=$(readlink -f "$d") && break
done
: "${STEAM_ROOT:?steam compat dir not found}"
LUTRIS_ROOT=$(readlink -f "$LUTRIS_HOME" 2>/dev/null || echo "$LUTRIS_HOME")
REPO="GloriousEggroll/proton-ge-custom"
API_BASE="https://api.github.com/repos/$REPO"

# --- colors ---
NO_COLOR="${NO_COLOR:-}"
if [[ -t 1 && -z "$NO_COLOR" ]]; then
  D=$'\033[2m'
  B=$'\033[1m'
  R=$'\033[31m'
  G=$'\033[32m'
  Y=$'\033[33m'
  C=$'\033[36m'
  N=$'\033[0m'
else
  D=''
  B=''
  R=''
  G=''
  Y=''
  C=''
  N=''
fi

# --- helpers ---
die() {
  echo -e "${R}error${N}: $*" >&2
  exit 1
}
warn() { echo -e "${Y}warning${N}: $*" >&2; }

has_jq() { command -v jq &>/dev/null; }
has_gh() { command -v gh &>/dev/null && gh auth status &>/dev/null; }

# curl wrapper that injects token if available
gh_curl() {
  local url="$1" extra=()
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    extra=(-H "Authorization: Bearer $GITHUB_TOKEN")
  elif [[ -n "${GH_TOKEN:-}" ]]; then
    extra=(-H "Authorization: Bearer $GH_TOKEN")
  fi
  curl -s --fail "${extra[@]}" "$url" 2>/dev/null
}

# try gh cli first (authed, higher rate limit), then curl with token, then plain curl
github_api() {
  local path="$1"
  local url="$API_BASE/$path"
  # prefer gh if authed
  if has_gh; then
    gh api "repos/$REPO/$path" 2>/dev/null && return
  fi
  if gh_curl "$url"; then return; fi
  # last resort plain curl (unauthenticated, 60/hr)
  curl -s --fail "$url" 2>/dev/null || return 1
}

# collect GE dirs in a root: "basename|realpath|issymlink"
ge_dirs() {
  local root="$1" p
  shopt -s nullglob
  for p in "$root"/GE-Proton*; do
    [[ -d "$p" || -L "$p" ]] || continue
    local bn rp sym
    bn=$(basename "$p")
    rp=$(readlink -f "$p")
    sym=0
    [[ -L "$p" ]] && sym=1
    printf '%s|%s|%s\n' "$bn" "$rp" "$sym"
  done
}

version_tag() {
  local dir="$1"
  local vf="$dir/version"
  if [[ -r "$vf" ]]; then
    local tag
    tag=$(awk '{print $2}' "$vf" 2>/dev/null | sed 's/-x86_64$//;s/-aarch64$//')
    [[ -n "$tag" ]] && {
      echo "$tag"
      return
    }
  fi
  basename "$dir" 2>/dev/null | sed 's/-x86_64$//;s/-aarch64$//'
}

normalize_ver() {
  local arg="$1"
  if [[ "$arg" == GE-Proton* ]]; then
    echo "$arg"
  else
    echo "GE-Proton$arg"
  fi
}

find_ge_dirs() {
  local name="$1" root p bn rp sym
  for root in "$STEAM_ROOT" "$LUTRIS_ROOT"; do
    shopt -s nullglob
    for p in "$root"/"$name" "$root"/"$name"-x86_64 "$root"/"$name"-aarch64; do
      [[ -d "$p" || -L "$p" ]] || continue
      bn=$(basename "$p")
      rp=$(readlink -f "$p")
      sym=0
      [[ -L "$p" ]] && sym=1
      printf '%s|%s|%s|%s\n' "$root" "$bn" "$rp" "$sym"
    done
  done | sort -u
}

active_name() {
  local target
  target=$(readlink -f "$ACTIVE_PATH" 2>/dev/null || echo "")
  [[ -n "$target" ]] && basename "$target"
}

size_human() { du -sh "$1" 2>/dev/null | cut -f1; }
size_kb() { du -sk "$1" 2>/dev/null | cut -f1; }

cell() { # $1 color, $2 text, $3 width — centered
  local c="$1" t="$2" w="$3" l pad left right
  l=${#t}
  pad=$((w - l))
  ((pad < 0)) && pad=0
  left=$((pad / 2))
  right=$((pad - left))
  printf "%*s%s%s%s%*s" "$left" "" "$c" "$t" "$N" "$right" ""
}
header_cell() { # $1 text, $2 width — centered dim header
  local t="$1" w="$2" l pad left right
  l=${#t}
  pad=$((w - l))
  ((pad < 0)) && pad=0
  left=$((pad / 2))
  right=$((pad - left))
  printf "${D}%*s%s%*s${N}" "$left" "" "$t" "$right" ""
}

is_active() {
  local rp="$1" act
  act=$(readlink -f "$ACTIVE_PATH" 2>/dev/null || echo "")
  [[ -n "$act" && "$rp" == "$act" ]]
}

# pretty path with ~
tilde() { echo "${1/#$HOME/\~}"; }

# fix GE-Proton 11.5+ which ships `from typing import Self` (py3.11+) but sniper still has py3.9
# also needs `from __future__ import annotations` for `X | None` pipe syntax
patch_proton_py39() {
  local dir="$1"
  [[ -d "$dir" ]] || return 0
  local vk="$dir/vulkan.py" util="$dir/utilities.py"
  local patched=0
  if [[ -f "$vk" ]] && grep -q "from typing import Self" "$vk" 2>/dev/null && ! grep -q 'Self = TypeVar' "$vk" 2>/dev/null; then
    python3 - "$vk" <<'PY'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
txt = p.read_text()
orig = txt
# idempotent: only patch if not already has fallback
if 'Self = TypeVar("Self")' not in txt and "from typing import Self" in txt:
    if "from __future__ import annotations" not in txt:
        txt = txt.replace("import uuid", "from __future__ import annotations\nimport uuid", 1)
    txt = txt.replace("from typing import Self", "try:\n    from typing import Self\nexcept ImportError:\n    from typing import TypeVar\n    Self = TypeVar(\"Self\")")
if txt != orig:
    p.write_text(txt)
    print(f"    patched {p}")
PY
    patched=1
  fi
  if [[ -f "$util" ]] && grep -q " | None" "$util" 2>/dev/null && ! grep -q "from __future__ import annotations" "$util" 2>/dev/null; then
    python3 - "$util" <<'PY'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
txt = p.read_text()
orig = txt
if "from __future__ import annotations" not in txt:
    if '"""Various utility' in txt:
        txt = txt.replace('"""Various utility', 'from __future__ import annotations\n"""Various utility', 1)
    else:
        txt = "from __future__ import annotations\n" + txt
if "from functools import cache" in txt and "lru_cache as cache" not in txt:
    txt = txt.replace("from functools import cache", "try:\n    from functools import cache\nexcept ImportError:\n    from functools import lru_cache as cache")
if txt != orig:
    p.write_text(txt)
    print(f"    patched {p}")
PY
    patched=1
  fi
  # also handle bare cache fallback even if future already present
  if [[ -f "$util" ]] && grep -q "from functools import cache" "$util" 2>/dev/null && ! grep -q "lru_cache as cache" "$util" 2>/dev/null; then
    python3 - "$util" <<'PY'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
txt = p.read_text()
orig = txt
txt = txt.replace("from functools import cache", "try:\n    from functools import cache\nexcept ImportError:\n    from functools import lru_cache as cache")
if txt != orig:
    p.write_text(txt)
    print(f"    patched cache fallback {p}")
PY
  fi
  return 0
}

patch_all_protons() {
  local rp _bn _sym
  while IFS='|' read -r _bn rp _sym; do
    patch_proton_py39 "$(readlink -f "$rp")"
  done < <(ge_dirs "$STEAM_ROOT")
  while IFS='|' read -r _bn rp _sym; do
    [[ "$_sym" == 1 ]] && continue
    patch_proton_py39 "$(readlink -f "$rp")"
  done < <(ge_dirs "$LUTRIS_ROOT")
}

installed_set() {
  declare -gA INSTALLED=()
  local bn rp sym
  while IFS='|' read -r bn rp sym; do INSTALLED["$bn"]=1; done < <(ge_dirs "$STEAM_ROOT")
  while IFS='|' read -r bn rp sym; do INSTALLED["$bn"]=1; done < <(ge_dirs "$LUTRIS_ROOT")
  # also by version tag
  while IFS='|' read -r bn rp sym; do INSTALLED["$(version_tag "$rp")"]=1; done < <(ge_dirs "$STEAM_ROOT")
}

# resolve tag to canonical form; strip arch suffix, ensure GE-Proton prefix
canonical_tag() {
  local v="$1"
  v=$(normalize_ver "$v")
  v=${v%-x86_64}
  v=${v%-aarch64}
  echo "$v"
}

# ================= commands =================

cmd_update() {
  echo -e "${C}checking${N} latest GE-Proton..."
  local data tag url fn tmp dirname cur
  data=$(github_api "releases/latest") || die "failed to fetch latest release (rate limited? try GITHUB_TOKEN or 'gh auth login')"
  if has_jq; then
    tag=$(echo "$data" | jq -r '.tag_name // empty')
    url=$(echo "$data" | jq -r '.assets[] | select(.name | test("x86_64\\.tar\\.gz$")) | .browser_download_url' | head -1)
  else
    tag=$(echo "$data" | grep '"tag_name"' | cut -d'"' -f4)
    url=$(echo "$data" | grep browser_download_url | grep 'x86_64.tar.gz"' | cut -d'"' -f4 | head -1)
  fi
  [[ -z "$tag" ]] && die "failed to parse latest release (rate limit?)"
  [[ -z "$url" ]] && die "no x86_64 asset found for $tag"

  cur=$(version_tag "$(readlink -f "$ACTIVE_PATH" 2>/dev/null || echo ".")" 2>/dev/null || echo "")
  if [[ "$tag" == "$cur" ]]; then
    echo -e "${G}already${N} on $tag"
    return
  fi
  echo -e "updating ${D}${cur:-none}${N} ${C}->${N} ${G}$tag${N}"
  _download_and_extract "$url" "$tag" >/dev/null
}

_download_and_extract() {
  local url="$1" tag="$2" set_active="${3:-1}"
  local fn tmp dirname
  fn=$(basename "$url")
  tmp="/tmp/$fn"
  echo -e "downloading ${D}$fn${N}" >&2
  echo -e "${D}  $url${N}" >&2
  curl -L --fail --progress-bar "$url" -o "$tmp" || {
    rm -f "$tmp"
    die "download failed"
  }
  file "$tmp" | grep -q gzip || {
    head -c 400 "$tmp" >&2
    echo >&2
    rm -f "$tmp"
    die "not a gzip archive (rate limited or bad url?)"
  }

  mkdir -p "$STEAM_ROOT"
  echo -e "extracting ${D}$fn${N} ${D}-> $(tilde "$STEAM_ROOT")${N}" >&2
  tar -xzf "$tmp" -C "$STEAM_ROOT"
  rm -f "$tmp"

  dirname="${fn%.tar.gz}"
  # some old releases extract without arch suffix
  if [[ ! -d "$STEAM_ROOT/$dirname" ]]; then
    # try without arch suffix or plain tag
    if [[ -d "$STEAM_ROOT/$tag" ]]; then
      dirname="$tag"
    elif [[ -d "$STEAM_ROOT/${tag}-x86_64" ]]; then
      dirname="${tag}-x86_64"
    else
      # find newest GE-Proton dir by mtime as fallback
      dirname=$(ls -t "$STEAM_ROOT"/GE-Proton* 2>/dev/null | head -1 | xargs -r basename)
      [[ -z "$dirname" ]] && die "extract failed: no GE-Proton dir found"
    fi
  fi

  # py3.9 compat: fix vulkan.py Self import that breaks inside sniper (py3.9)
  patch_proton_py39 "$STEAM_ROOT/$dirname" 2>/dev/null || true

  if ((set_active)); then
    ln -sfn "$STEAM_ROOT/$dirname" "$ACTIVE_PATH"
    echo -e "${G}done${N} $tag ${D}($dirname)${N} ${D}active -> $(tilde "$ACTIVE_PATH")${N}" >&2
  else
    echo -e "${G}done${N} $tag ${D}($dirname)${N} ${D}(active unchanged)${N}" >&2
  fi
  echo "$dirname"
}

cmd_list() {
  declare -A S_DIR S_SZ L_DIR L_SYM L_SZ
  local bn rp sym
  while IFS='|' read -r bn rp sym; do
    S_DIR["$bn"]="$rp"
    S_SZ["$bn"]=$(size_human "$rp")
  done < <(ge_dirs "$STEAM_ROOT")
  while IFS='|' read -r bn rp sym; do
    L_DIR["$bn"]="$rp"
    L_SYM["$bn"]="$sym"
    L_SZ["$bn"]=$(size_human "$rp")
  done < <(ge_dirs "$LUTRIS_ROOT")

  local active_rp
  active_rp=$(readlink -f "$ACTIVE_PATH" 2>/dev/null || echo "")

  local names
  names=$({
    for bn in "${!S_DIR[@]}"; do echo "$bn"; done
    for bn in "${!L_DIR[@]}"; do echo "$bn"; done
  } | sort -t- -k2,2V -k3,3V -u)

  local active
  active=$(active_name || echo "")

  declare -A SEEN
  local total_kb=0 kb
  while IFS='|' read -r bn rp sym; do
    [[ -n "${SEEN[$rp]:-}" ]] && continue
    SEEN["$rp"]=1
    kb=$(size_kb "$rp")
    total_kb=$((total_kb + ${kb:-0}))
  done < <(ge_dirs "$STEAM_ROOT")
  while IFS='|' read -r bn rp sym; do
    [[ -n "${SEEN[$rp]:-}" ]] && continue
    SEEN["$rp"]=1
    kb=$(size_kb "$rp")
    total_kb=$((total_kb + ${kb:-0}))
  done < <(ge_dirs "$LUTRIS_ROOT")

  local total_human
  total_human=$(numfmt --to=iec --suffix=B --format='%.1f' $((total_kb * 1024)) 2>/dev/null || echo "${total_kb}K")

  local s_count=0 l_count=0
  # shellcheck disable=SC2066
  for name in $names; do
    [[ -n "${S_DIR[$name]:-}" ]] && s_count=$((s_count + 1))
    [[ -n "${L_DIR[$name]:-}" ]] && l_count=$((l_count + 1))
  done

  local ver_w=7
  for name in $names; do ((${#name} > ver_w)) && ver_w=${#name}; done

  local s_char l_char a_char s_col l_col a_col size
  printf "${D}%-${ver_w}s  %7s  " "VERSION" "SIZE"
  header_cell "STEAM" 6
  printf "  "
  header_cell "LUTRIS" 6
  printf "  "
  header_cell "ACTIVE" 6
  printf "${N}\n"
  for name in $names; do
    size="${S_SZ[$name]:-${L_SZ[$name]:-?}}"
    if [[ -n "${S_DIR[$name]:-}" ]]; then
      s_char="●"
      s_col="$G"
    else
      s_char="·"
      s_col="$D"
    fi
    if [[ -n "${L_DIR[$name]:-}" ]]; then
      if [[ "${L_SYM[$name]}" == 1 ]]; then
        l_char=""
        l_col="$C"
      else
        l_char="●"
        l_col="$R"
      fi
    elif [[ -n "$active_rp" && "${S_DIR[$name]:-}" == "$active_rp" ]]; then
      l_char=""
      l_col="$C"
    else
      l_char="·"
      l_col="$D"
    fi
    if [[ "$name" == "$active" ]]; then
      a_char="*"
      a_col="$Y"
    else
      a_char="·"
      a_col="$D"
    fi
    printf "${B}%-${ver_w}s${N}  ${Y}%7s${N}  " "$name" "$size"
    cell "$s_col" "$s_char" 6
    printf "  "
    cell "$l_col" "$l_char" 6
    printf "  "
    cell "$a_col" "$a_char" 6
    printf "\n"
  done
  [[ -z "$names" ]] && echo -e "${D}no GE-Proton versions found${N}"
  echo ""
  echo -e "${D}steam:${N}  $(tilde "$STEAM_ROOT")   ${D}($s_count)${N}"
  echo -e "${D}lutris:${N} $(tilde "$LUTRIS_ROOT")  ${D}($l_count)${N}"
  echo -e "${D}total:${N}  $total_human"
  local active_target
  active_target=$(readlink -f "$ACTIVE_PATH" 2>/dev/null || echo "none")
  if [[ "$active_target" != "none" && -n "$active" ]]; then
    echo -e "${D}active:${N} $(tilde "$ACTIVE_PATH") ${D}→${N} $(tilde "$active_target")"
  else
    echo -e "${D}active:${N} $(tilde "$ACTIVE_PATH") ${D}→${N} ${D}none${N}"
  fi
  echo -e "${D}legend:${N} ${G}●${N} present  ${C}${N} symlink  ${R}●${N} real copy (needs prune)  ${Y}*${N} active  ${D}·${N} missing"
}

# --- link: ensure every steam version has a lutris symlink (old prune phase 1) ---
cmd_link() {
  local changed=0 sbn srp ssym lbn lrp lsym
  local lutris_dirs
  lutris_dirs=$(ge_dirs "$LUTRIS_ROOT")
  while IFS='|' read -r sbn srp ssym; do
    # ensure lutris has it (by name or version tag)
    local has=0
    while IFS='|' read -r lbn lrp lsym; do
      if [[ "$lbn" == "$sbn" ]] || [[ "$(version_tag "$lrp")" == "$(version_tag "$srp")" ]]; then
        has=1
        break
      fi
    done <<<"$lutris_dirs"
    ((has)) && continue
    echo -e "${C}link${N} $sbn ${D}steam -> lutris${N}"
    mkdir -p "$LUTRIS_ROOT"
    ln -s "$srp" "$LUTRIS_ROOT/$sbn"
    changed=$((changed + 1))
  done < <(ge_dirs "$STEAM_ROOT")

  if ((changed == 0)); then
    echo -e "${G}all linked${N} ${D}every steam version is already in lutris${N}"
  else
    echo -e "${G}$changed linked${N}"
  fi
}

# --- prune/dedupe: replace lutris real copies with symlinks to steam (old prune phase 2) ---
cmd_prune() {
  local changed=0 bn rp sym sbn srp ssym
  local steam_dirs
  steam_dirs=$(ge_dirs "$STEAM_ROOT")
  while IFS='|' read -r bn rp sym; do
    ((sym)) && continue
    local steam_match="" steam_path="$STEAM_ROOT/$bn"
    if [[ -e "$steam_path" || -L "$steam_path" ]]; then
      steam_match=$(readlink -f "$steam_path")
    else
      local tag
      tag=$(version_tag "$rp")
      while IFS='|' read -r sbn srp ssym; do
        if [[ "$(version_tag "$srp")" == "$tag" ]]; then
          steam_match="$srp"
          break
        fi
      done <<<"$steam_dirs"
    fi
    if [[ -z "$steam_match" ]]; then
      echo -e "${D}skip${N} $bn ${D}(no steam counterpart)${N}"
      continue
    fi
    echo -e "${C}prune${N} $bn ${D}lutris -> steam${N} ${D}$(size_human "$rp") freed${N}"
    rm -rf "$LUTRIS_ROOT/${bn:?}"
    ln -s "$steam_match" "$LUTRIS_ROOT/$bn"
    changed=$((changed + 1))
  done < <(ge_dirs "$LUTRIS_ROOT")

  if ((changed == 0)); then
    echo -e "${G}all deduped${N} ${D}no real copies in lutris${N}"
  else
    echo -e "${G}$changed pruned${N}"
  fi
}

cmd_remove() {
  local confirm=1 force=0
  local targets=()
  for arg in "$@"; do
    case "$arg" in
    -y | --yes) confirm=0 ;;
    --force) force=1 ;;
    *) targets+=("$arg") ;;
    esac
  done
  ((${#targets[@]} == 0)) && die "give at least one version (e.g. 11-1, GE-Proton11-3)"

  declare -A SEEN
  local name found hits=()
  for arg in "${targets[@]}"; do
    name=$(normalize_ver "$arg")
    found=0
    while IFS='|' read -r root bn rp sym; do
      found=1
      [[ -n "${SEEN[$root|$bn]:-}" ]] && continue
      SEEN[$root|$bn]=1
      hits+=("$root|$bn|$rp|$sym")
    done < <(find_ge_dirs "$name")
    ((found)) || warn "no match for '$arg'"
  done
  ((${#hits[@]} == 0)) && die "nothing matched"

  local line root bn rp sym active_hit=""
  for line in "${hits[@]}"; do
    IFS='|' read -r root bn rp sym <<<"$line"
    if is_active "$rp"; then active_hit="$bn"; fi
  done
  if [[ -n "$active_hit" ]]; then
    if ((force)); then
      warn "removing active version $active_hit (--force)"
    else die "refusing to remove active $active_hit (switch with 'pvm use <ver>' or --force)"; fi
  fi

  for line in "${hits[@]}"; do
    IFS='|' read -r root bn rp sym <<<"$line"
    local tag
    tag=$(version_tag "$rp")
    local games
    games=$(grep -rls "version:.*$tag" "$HOME/.local/share/lutris/games/" 2>/dev/null | xargs -r -n1 basename | sed 's/\.yml$//' || true)
    [[ -n "$games" ]] && warn "configs use $tag: $games"
  done

  echo ""
  for line in "${hits[@]}"; do
    IFS='|' read -r root bn rp sym <<<"$line"
    echo -e "  ${D}$(tilde "$root")${N} ${Y}$bn${N} ${D}$(size_human "$rp")${N}"
  done
  echo ""
  if ((confirm)); then
    read -r -p "remove these? [y/N] " ans
    [[ "$ans" == y || "$ans" == Y ]] || {
      echo "aborted"
      return
    }
  fi
  local removed=0
  for line in "${hits[@]}"; do
    IFS='|' read -r root bn rp sym <<<"$line"
    echo -e "${R}remove${N} ${D}$(tilde "$root")${N}/$bn"
    rm -rf "$root/${bn:?}"
    removed=$((removed + 1))
  done
  echo -e "${G}removed $removed${N}"
}

cmd_use() {
  (($# == 0)) && die "give a version (e.g. '11-5' or 'GE-Proton11-5')"
  local name rp bn target=""
  name=$(normalize_ver "$1")
  while IFS='|' read -r root bn rp sym; do target="$rp"; done < <(find_ge_dirs "$name")
  [[ -z "$target" ]] && die "version '$1' not found (try 'pvm list' or 'pvm search $1')"
  [[ ! -d "$target" ]] && die "target $target is not a valid directory"
  # ensure target is py3.9-compatible before activating (fixes 11.5+ on sniper)
  patch_proton_py39 "$(readlink -f "$target")" 2>/dev/null || true
  local target_bn cur
  target_bn=$(basename "$target")
  cur=$(active_name || echo "none")
  if [[ "$cur" == "$target_bn" ]]; then
    echo -e "${G}already${N} on $target_bn"
    return
  fi
  mkdir -p "$LUTRIS_ROOT"
  ln -sfn "$target" "$ACTIVE_PATH"
  echo -e "switched ${D}$cur${N} ${C}->${N} ${G}$target_bn${N}"
}

# patch all installed protons for py3.9 compat (fixes GE-Proton 11.5+ Self import)
cmd_patch() {
  echo -e "${C}patching${N} installed GE-Protons for py3.9 compat..."
  patch_all_protons
  if [[ -L "$ACTIVE_PATH" ]]; then
    patch_proton_py39 "$(readlink -f "$ACTIVE_PATH")" 2>/dev/null || true
  fi
  echo -e "${G}done${N} ${D}all installed protons are now sniper-py3.9 compatible${N}"
}

# --- search: query GitHub releases ---
cmd_search() {
  local query="" limit=20 json=0 verbose=0
  local args=()
  while (($#)); do
    case "$1" in
    --limit=*)
      limit="${1#*=}"
      shift
      ;;
    --limit)
      limit="${2:-}"
      shift 2
      ;;
    --json)
      json=1
      shift
      ;;
    -v | --verbose)
      verbose=1
      shift
      ;;
    -l | --all)
      limit=100
      shift
      ;;
    -h | --help)
      _help_search
      return
      ;;
    --)
      shift
      break
      ;;
    -*) die "unknown flag '$1' (try: pvm search --help)" ;;
    *)
      if [[ -z "$query" ]]; then query="$1"; else args+=("$1"); fi
      shift
      ;;
    esac
  done
  # any leftover args are errors
  if ((${#args[@]})); then die "too many args: ${args[*]}"; fi

  [[ "$limit" =~ ^[0-9]+$ ]] || die "--limit must be a number"
  ((limit > 100)) && limit=100

  echo -e "${C}searching${N} ${D}$REPO${N} ${D}${query:+query: \"$query\"}${N} ${D}(limit $limit)${N}"

  local data
  # use per_page to avoid pagination for small limits
  data=$(github_api "releases?per_page=$limit") || {
    warn "GitHub API failed (rate limited?)"
    echo -e "${D}try:${N} GITHUB_TOKEN=ghp_xxx pvm search $query"
    echo -e "${D} or:${N} gh auth login && pvm search $query"
    echo -e "${D} or browse:${N} https://github.com/$REPO/releases"
    return 1
  }

  installed_set

  local count=0
  if has_jq; then
    if ((json)); then
      if [[ -n "$query" ]]; then
        echo "$data" | jq --arg q "$query" '[ .[] | select(.tag_name | test($q; "i")) ]'
      else
        echo "$data" | jq '.'
      fi
      return
    fi
    # pretty table via jq
    # build rows
    local jq_out
    jq_out=$(echo "$data" | jq -r --arg q "$query" '
      map(select(if $q == "" then true else .tag_name | test($q; "i") end))
      | .[] | "\(.tag_name)|\(.published_at // .created_at)|\(.assets | length)|\(.html_url)"
    ' 2>/dev/null)
    if [[ -z "$jq_out" ]]; then
      echo -e "${D}no releases matched \"$query\"${N}"
      return
    fi
    if ((verbose)); then
      printf "${D}%-18s  %-12s  %-4s  %-9s  %s${N}\n" "TAG" "DATE" "STAT" "STATUS" "URL"
    else
      printf "${D}%-18s  %-12s  %-4s  %-9s${N}\n" "TAG" "DATE" "STAT" "STATUS"
    fi
    while IFS='|' read -r tag date assets url; do
      count=$((count + 1))
      local short_date inst="" stat_col="$D" stat="·"
      short_date=$(echo "$date" | cut -dT -f1)
      if [[ -n "${INSTALLED[$tag]:-}" ]]; then
        inst="installed"
        stat="●"
        stat_col="$G"
      fi
      local tag_col="$B"
      [[ -n "$inst" ]] && tag_col="$G"
      printf "${tag_col}%-18s${N}  " "$tag"
      printf "${D}%-12s${N}  " "$short_date"
      cell "$stat_col" "$stat" 4
      printf "  "
      if [[ -n "$inst" ]]; then printf "${G}%-9s${N}" "$inst"; else printf "${D}%-9s${N}" ""; fi
      if ((verbose)); then printf "  ${D}%s${N}" "$url"; fi
      printf "\n"
    done <<<"$jq_out"
    [[ $count -eq 0 ]] && echo -e "${D}no match for \"$query\"${N}"
  else
    # fallback without jq: crude grep
    local tags
    tags=$(echo "$data" | grep '"tag_name"' | cut -d'"' -f4)
    if [[ -n "$query" ]]; then
      tags=$(echo "$tags" | grep -i "$query" || true)
    fi
    tags=$(echo "$tags" | head -n "$limit")
    if [[ -z "$tags" ]]; then
      echo -e "${D}no match for \"$query\"${N}"
      return
    fi
    printf "${D}%-18s  %-6s${N}\n" "TAG" "STATUS"
    while read -r tag; do
      [[ -z "$tag" ]] && continue
      local inst="" col="$B"
      if [[ -n "${INSTALLED[$tag]:-}" ]]; then
        inst="installed"
        col="$G"
      fi
      printf "${col}%-18s${N}  ${D}%s${N}\n" "$tag" "$inst"
    done <<<"$tags"
  fi
  echo ""
  echo -e "${D}tip:${N} pvm install <tag>  ${D}to download  •  pvm list  ${D}to see local${N}"
}

_help_search() {
  cat <<EOF
${B}pvm search${N} - search remote GE-Proton releases

  pvm search [query] [--limit N] [--json] [-v]

  query      filter tags (e.g. "11-5", "10-")
  --limit N  max results (default 20, max 100)
  --json     raw JSON output
  -v, --verbose  show URL column
  --all      alias for --limit 100

  examples:
    pvm search              # latest 20
    pvm search --limit 10   # 10 latest
    pvm search 11-5         # find 11-5
    pvm search 10 --limit 5 -v
EOF
}

# --- install/download: fetch specific version ---
cmd_install() {
  local arch="x86_64" reinstall=0 no_link=0 ver=""
  local args=("$@") i
  for ((i = 0; i < ${#args[@]}; i++)); do
    case "${args[i]}" in
    --arch=*) arch="${args[i]#*=}" ;;
    --arch)
      arch="${args[i + 1]:-}"
      ((i++))
      ;;
    --reinstall | -f | --force) reinstall=1 ;;
    --no-link) no_link=1 ;;
    -h | --help)
      _help_install
      return
      ;;
    -*) die "unknown flag '${args[i]}'" ;;
    *) ver="${args[i]}" ;;
    esac
  done
  [[ -z "$ver" ]] && {
    _help_install
    die "give a version (e.g. pvm install 11-5)"
  }
  if [[ "$ver" == "latest" ]]; then
    cmd_update
    return
  fi

  local tag
  tag=$(canonical_tag "$ver")
  echo -e "${C}resolving${N} $tag ${D}arch=$arch${N}"

  # check if already installed — steam vs lutris matters
  local already="" already_root="" already_bn=""
  local steam_has=0 lutris_real=0
  while IFS='|' read -r root bn rp sym; do
    [[ -z "$already" ]] && {
      already="$rp"
      already_root="$root"
      already_bn="$bn"
    }
    [[ "$root" == "$STEAM_ROOT" ]] && steam_has=1
    [[ "$root" == "$LUTRIS_ROOT" && "$sym" == 0 ]] && lutris_real=1
  done < <(find_ge_dirs "$tag")

  if [[ -n "$already" && $reinstall -eq 0 ]]; then
    if ((steam_has)); then
      echo -e "${Y}already installed${N} $already_bn ${D}at $(tilde "$already_root")${N}"
      echo -e "${D}use --reinstall to force re-download${N}"
      # still ensure py39 compat even if we skip download
      patch_proton_py39 "$(readlink -f "$already")" 2>/dev/null || true
      return
    elif ((lutris_real)); then
      echo -e "${Y}found lutris-only${N} $already_bn ${D}($(tilde "$already_root"), real copy)${N}"
      echo -e "${D}no steam counterpart — downloading to steam so prune can dedupe...${N}"
      # fall through to download
    else
      echo -e "${Y}already installed${N} $already_bn ${D}at $(tilde "$already_root")${N}"
      echo -e "${D}use --reinstall to force re-download${N}"
      patch_proton_py39 "$(readlink -f "$already")" 2>/dev/null || true
      return
    fi
  fi
  if [[ -n "$already" && $reinstall -eq 1 ]]; then
    echo -e "${D}reinstalling${N} $tag"
  fi

  # 1) try GitHub API for exact tag to get asset url
  local url="" data
  data=$(github_api "releases/tags/$tag" 2>/dev/null || echo "")
  if [[ -n "$data" ]]; then
    if has_jq; then
      # prefer arch-specific, fallback to plain .tar.gz (old releases)
      url=$(echo "$data" | jq -r --arg arch "$arch" '
        .assets[]? | select(.name | endswith("\($arch).tar.gz")) | .browser_download_url
      ' 2>/dev/null | head -1)
      if [[ -z "$url" || "$url" == "null" ]]; then
        url=$(echo "$data" | jq -r '.assets[]? | select(.name | endswith(".tar.gz")) | .browser_download_url' 2>/dev/null | head -1)
        [[ "$url" == "null" ]] && url=""
      fi
    else
      url=$(echo "$data" | grep browser_download_url | grep "$arch.tar.gz\"" | cut -d'"' -f4 | head -1)
      [[ -z "$url" ]] && url=$(echo "$data" | grep browser_download_url | grep '\.tar\.gz"' | cut -d'"' -f4 | head -1)
    fi
  fi

  # 2) fallback: try direct download URLs without API (avoids rate limit)
  if [[ -z "$url" ]]; then
    warn "API lookup failed, trying direct URLs"
    local candidates=(
      "https://github.com/$REPO/releases/download/$tag/${tag}-${arch}.tar.gz"
      "https://github.com/$REPO/releases/download/$tag/${tag}.tar.gz"
    )
    for c in "${candidates[@]}"; do
      if curl -sI --fail "$c" &>/dev/null; then
        url="$c"
        echo -e "${D}found${N} $c"
        break
      fi
    done
  fi

  [[ -z "$url" ]] && die "could not resolve asset for $tag (arch $arch). Check tag exists: pvm search $tag"

  echo -e "${C}installing${N} $tag ${D}from${N} ${D}$(basename "$url")${N}"
  # don't touch the active symlink; only 'pvm use' swaps it
  local dirnm
  dirnm=$(_download_and_extract "$url" "$tag" 0)

  if ((!no_link)); then
    # auto-link to lutris so the runner shows up there
    mkdir -p "$LUTRIS_ROOT"
    if [[ ! -e "$LUTRIS_ROOT/$dirnm" ]]; then
      ln -s "$STEAM_ROOT/$dirnm" "$LUTRIS_ROOT/$dirnm" 2>/dev/null || true
    fi
  fi
}

_help_install() {
  cat <<EOF
${B}pvm install${N} - download a specific GE-Proton version

  pvm install <ver> [options]
  aliases: pvm get, pvm download, pvm fetch

  ver     version tag: "11-5", "GE-Proton11-5", "GE-Proton11-5-x86_64", or "latest"
  --arch <arch>   x86_64 (default) or aarch64
  --reinstall     re-download even if already installed
  --no-link       don't auto-link to lutris

  examples:
    pvm install 11-5
    pvm install GE-Proton9-20 --arch aarch64
    pvm install latest
    pvm get 11-6 --reinstall
EOF
}

# --- probe: report which proton/wine/ge version a prefix was built with ---
cmd_probe() {
  (($# == 1)) || die "give exactly one prefix dir (e.g. 'pvm probe ~/wine-tekken')"
  local prefix="$1"
  [[ -d "$prefix" ]] || die "prefix not found: $prefix"
  prefix=$(readlink -f "$prefix" 2>/dev/null || echo "$prefix")
  [[ -d "$prefix/drive_c" ]] || warn "no drive_c in $(tilde "$prefix"); not clearly a wine prefix"

  local recorded="" info_ver=""
  if [[ -r "$prefix/version" ]]; then
    recorded=$(tr -d '[:space:]' < "$prefix/version")
    # a leading build timestamp can sneak in; keep just the tag
    if [[ "$recorded" =~ ^[0-9]+(GE-Proton.*)$ ]]; then
      recorded="${BASH_REMATCH[1]}"
    fi
  fi
  if [[ -r "$prefix/config_info" ]]; then
    info_ver=$(head -1 "$prefix/config_info" | tr -d '[:space:]')
  fi

  local arch=""
  if [[ -r "$prefix/system.reg" ]]; then
    arch=$(grep -m1 '^#arch=' "$prefix/system.reg" | cut -d= -f2)
  fi

  echo -e "${B}prefix${N}  $(tilde "$prefix")"
  echo -e "${B}arch${N}    ${arch:-unknown}"

  if [[ -z "$recorded" && -z "$info_ver" ]]; then
    die "no wine/proton version recorded in this prefix (missing 'version' and 'config_info')"
  fi

  local tag=""
  if [[ -n "$recorded" ]]; then
    tag=$(canonical_tag "$recorded")
  else
    tag=$(canonical_tag "$info_ver")
  fi

  echo -e "${B}version${N} ${G}$tag${N}"

  if [[ -n "$recorded" && -n "$info_ver" && "$recorded" != "$info_ver" ]]; then
    warn "version file says '$recorded' but config_info says '$info_ver'"
  fi

  local matches=() seen="" rp
  while IFS='|' read -r root bn rp sym; do
    if [[ ";$seen;" != *";$rp;"* ]]; then
      seen="$seen;$rp"
      matches+=("$root|$bn|$rp|$sym")
    fi
  done < <(find_ge_dirs "$tag")

  echo -e "${B}installed:${N}"
  if ((${#matches[@]})); then
    for line in "${matches[@]}"; do
      IFS='|' read -r root bn rp sym <<<"$line"
      local loc="${D}lutris${N}"
      [[ "$root" == "$STEAM_ROOT" ]] && loc="${D}steam${N}"
      echo -e "  $loc $(tilde "$root")/${D}$bn${N}"
      [[ "$sym" == 1 ]] && echo -e "    ${D}-> $(tilde "$rp")${N}"
    done
  else
    echo -e "  ${Y}none${N} ${D}(recorded but not found under steam or lutris)${N}"
  fi
}

_help_migrate() {
  cat <<EOF
${B}pvm migrate${N} - change and rebuild a wine prefix to another proton version

  pvm migrate <prefix> <ver> [options]

  prefix   path to wine prefix (must contain drive_c)
  ver      target proton version: "11-5", "GE-Proton11-5", etc.

  options:
    --backup          create full tarball backup before migrating (default: meta files only)
    --no-backup       skip even meta backup (version/config_info/system.reg)
    --rebuild         run wineboot -u to rebuild prefix (default: yes)
    --no-rebuild      only swap version files, don't run wineboot
    --fresh, --nuke    nuke the prefix and rebuild it from scratch,
                      preserving saves (drive_c/users, drive_c/ProgramData).
                      fixes prefixes where dlls got zeroed and wineboot
                      can no longer heal them. implies --force.
                      close games using the prefix first.
    --keep <path>     extra path inside the prefix to preserve across
                      --fresh (repeatable, e.g. --keep drive_c/games)
    -f, --force       allow migrating to same version (force rebuild)
    -n, --dry-run     show what would happen without changing anything
    -y, --yes         skip confirmation prompt
    --install         auto-install target proton if missing
    -h, --help        show this help

  examples:
    pvm migrate ~/wine-tekken 11-5
    pvm migrate ~/wine-tekken GE-Proton10-8 --backup
    pvm migrate ~/Games/pfx 11-6 --no-rebuild
    pvm migrate ~/pfx 11-5 --dry-run
    pvm migrate ~/wine-games 11-6 --fresh -y   # nuke + rebuild, keep saves
EOF
}

# run wineboot -u in a prefix via umu (fall back to proton, then raw wine).
# $1 prefix, $2 proton dir, $3 arch. always returns 0; warns on failure.
_run_wineboot_once() {
  local prefix="$1" dir="$2" arch="${3:-win64}"
  local umu=""
  umu=$(command -v umu-run 2>/dev/null || true)
  if [[ -z "$umu" ]]; then
    local cand
    for cand in "$HOME/.local/share/lutris/runtime/umu/umu-run" "/usr/local/share/umu/umu-run" "/usr/share/umu/umu-run" "/opt/umu/umu-run"; do [[ -x "$cand" ]] && umu="$cand" && break; done
  fi
  local -a envs=()
  envs+=("WINEARCH=$arch")
  envs+=("WINEPREFIX=$prefix")
  envs+=("PROTONPATH=$dir")
  envs+=("GAMEID=umu-migrate")
  envs+=("PROTON_VERB=waitforexitandrun")
  [[ -z "${WINEDEBUG:-}" ]] && envs+=("WINEDEBUG=-all")
  [[ -z "${DXVK_LOG_LEVEL:-}" ]] && envs+=("DXVK_LOG_LEVEL=error")
  [[ -z "${UMU_LOG:-}" ]] && envs+=("UMU_LOG=1")
  [[ -z "${WINEESYNC:-}" ]] && envs+=("WINEESYNC=1")
  [[ -z "${WINEFSYNC:-}" ]] && envs+=("WINEFSYNC=1")
  [[ -d "$dir/files/mono" ]] && envs+=("WINE_MONO_CACHE_DIR=$dir/files/mono")
  [[ -d "$dir/files/gecko" ]] && envs+=("WINE_GECKO_CACHE_DIR=$dir/files/gecko")
  [[ -z "${WINEDLLOVERRIDES:-}" ]] && envs+=("WINEDLLOVERRIDES=winemenubuilder=")
  [[ -n "${LC_ALL:-}" && -z "${HOST_LC_ALL:-}" ]] && envs+=("HOST_LC_ALL=$LC_ALL")
  local rc=0
  if [[ -n "$umu" && -x "$umu" ]]; then
    echo -e "${D}using umu:${N} $(tilde "$umu")" >&2
    if ! env "${envs[@]}" "$umu" wineboot -u 2>&1; then rc=$?; warn "umu wineboot exited $rc"; fi
  elif [[ -x "$dir/proton" ]]; then
    echo -e "${D}using proton:${N} $(tilde "$dir/proton") run wineboot -u" >&2
    if ! env "${envs[@]}" "$dir/proton" run wineboot -u 2>&1; then rc=$?; warn "proton wineboot exited $rc"; fi
  elif [[ -x "$dir/files/bin/wine" ]]; then
    warn "no umu/proton runner, falling back to direct wine"
    if ! env WINEPREFIX="$prefix" WINEARCH="$arch" "$dir/files/bin/wine" wineboot -u 2>&1; then rc=$?; warn "wine wineboot exited $rc"; fi
  else
    die "no runner found to rebuild prefix (need umu-run or $dir/proton)"
  fi
  return 0
}

# best-effort wineserver shutdown for a prefix so files can be moved/deleted.
_kill_prefix_server() {
  local prefix="$1" dir="${2:-}"
  if [[ -n "$dir" && -x "$dir/files/bin/wineserver" ]]; then
    WINEPREFIX="$prefix" "$dir/files/bin/wineserver" -k 2>/dev/null || true
  fi
  if command -v wineserver &>/dev/null; then
    WINEPREFIX="$prefix" wineserver -k 2>/dev/null || true
  fi
  sleep 1
}

# check the dlls that brick a prefix when zeroed. prints bad ones, returns 1 if any.
_check_prefix_dlls() {
  local prefix="$1" bad=0 f
  for f in ntdll.dll ucrtbase.dll msvcrt.dll kernel32.dll kernelbase.dll; do
    for d in system32 syswow64; do
      local p="$prefix/drive_c/windows/$d/$f"
      if [[ ! -s "$p" ]]; then
        echo -e "  ${R}bad${N}  drive_c/windows/$d/$f ${D}($(stat -c%s "$p" 2>/dev/null || echo missing) bytes)${N}" >&2
        bad=1
      fi
    done
  done
  return $bad
}

# fresh rebuild: nuke prefix, recreate via proton, restore saves.
# $1 prefix, $2 proton dir, $3 tag, $4 arch, $5 ts, $@ extra keep paths (relative to prefix)
cmd_migrate_fresh() {
  local prefix="$1" dir="$2" tag="$3" arch="${4:-win64}" ts="$5"
  shift 5
  local -a extra_keeps=("$@")
  local parent base staging
  parent=$(dirname "$prefix")
  base=$(basename "$prefix")
  staging="$parent/.${base}.fresh-staging.$ts"
  [[ -e "$staging" ]] && die "staging dir already exists: $(tilde "$staging") (remove it first)"

  local -a preserves=(drive_c/users drive_c/ProgramData lutris.json)
  local k
  if ((${#extra_keeps[@]})); then
    for k in "${extra_keeps[@]}"; do
      k="${k#/}"
      [[ -n "$k" ]] && preserves+=("$k")
    done
  fi

  echo -e "${B}preserve${N} ${D}(moved aside, restored after rebuild)${N}" >&2
  local p
  for p in "${preserves[@]}"; do
    if [[ -e "$prefix/$p" || -L "$prefix/$p" ]]; then
      echo -e "  ${G}keep${N} $p ${D}($(du -sh "$prefix/$p" 2>/dev/null | cut -f1))${N}" >&2
    else
      echo -e "  ${D}skip${N} $p ${D}(not present)${N}" >&2
    fi
  done
  echo -e "${B}nuke${N}     ${D}everything else in $(tilde "$prefix") (dlls, regs, dosdevices)${N}" >&2
  echo -e "${B}staging${N}   $(tilde "$staging")" >&2

  mkdir -p "$staging/meta"
  _kill_prefix_server "$prefix" "$dir"

  # meta copies live OUTSIDE the prefix so the nuke cannot eat them
  for f in version config_info system.reg user.reg userdef.reg; do
    [[ -r "$prefix/$f" ]] && cp -a "$prefix/$f" "$staging/meta/$f" 2>/dev/null || true
  done
  local had_pfx_link=0
  [[ -L "$prefix/pfx" ]] && had_pfx_link=1

  # move preserves to staging (same parent dir, so renames are instant)
  for p in "${preserves[@]}"; do
    if [[ -e "$prefix/$p" || -L "$prefix/$p" ]]; then
      mkdir -p "$staging/keep/$(dirname "$p")"
      mv "$prefix/$p" "$staging/keep/$p" || die "failed to stage $p"
    fi
  done
  echo -e "${C}nuking${N} ${D}$(tilde "$prefix") contents...${N}" >&2
  find "$prefix" -mindepth 1 -maxdepth 1 -exec rm -rf {} + || die "nuke failed"
  if ((had_pfx_link)); then ln -s . "$prefix/pfx"; fi

  echo -e "${C}rebuilding${N} ${D}fresh prefix with $tag...${N}" >&2
  _run_wineboot_once "$prefix" "$dir" "$arch"
  if _check_prefix_dlls "$prefix"; then
    echo -e "${G}prefix dlls healthy${N}" >&2
  else
    die "fresh prefix still has bad dlls — proton copy failed, saves are safe in $(tilde "$staging")"
  fi

  # drop the skeleton user dirs proton just made, move the real saves back
  _kill_prefix_server "$prefix" "$dir"
  for p in "${preserves[@]}"; do
    if [[ -e "$staging/keep/$p" || -L "$staging/keep/$p" ]]; then
      rm -rf "${prefix:?}/$p"
      mkdir -p "$(dirname "$prefix/$p")"
      mv "$staging/keep/$p" "$prefix/$p" || die "failed to restore $p (saves are in $(tilde "$staging"))"
      echo -e "  ${G}restored${N} $p" >&2
    fi
  done

  echo -e "${C}settling${N} ${D}second wineboot with saves in place...${N}" >&2
  _run_wineboot_once "$prefix" "$dir" "$arch"
  if _check_prefix_dlls "$prefix"; then
    echo -e "${G}rebuild verified${N} ${D}critical dlls healthy${N}" >&2
  else
    warn "critical dlls look bad after restore — saves are safe in $(tilde "$staging")"
  fi
  rmdir "$staging/keep" 2>/dev/null || true
  echo -e "${D}meta backup kept at $(tilde "$staging/meta") — delete when happy${N}" >&2
}

cmd_migrate() {
  local prefix="" target_ver="" do_backup="meta" do_rebuild=1 force=0 dry_run=0 yes=0 auto_install=0 fresh=0
  local -a positionals=() keeps=()
  while (($#)); do
    case "$1" in
    -h|--help) _help_migrate; return ;;
    --backup) do_backup="full"; shift ;;
    --no-backup) do_backup="none"; shift ;;
    --rebuild) do_rebuild=1; shift ;;
    --no-rebuild) do_rebuild=0; shift ;;
    --fresh|--nuke) fresh=1; force=1; shift ;;
    --keep) keeps+=("${2:-}"); shift 2 ;;
    --keep=*) keeps+=("${1#*=}"); shift ;;
    -f|--force) force=1; shift ;;
    -n|--dry-run) dry_run=1; shift ;;
    -y|--yes) yes=1; shift ;;
    --install) auto_install=1; shift ;;
    --) shift; while (($#)); do positionals+=("$1"); shift; done; break ;;
    -*) die "unknown flag '$1' (try: pvm migrate --help)" ;;
    *) positionals+=("$1"); shift ;;
    esac
  done
  if ((${#positionals[@]} < 2)); then
    _help_migrate
    die "need <prefix> and <ver> (e.g. pvm migrate ~/wine-tekken 11-5)"
  fi
  if ((${#positionals[@]} > 2)); then die "too many args: ${positionals[*]:2}"; fi
  prefix="${positionals[0]}"
  target_ver="${positionals[1]}"
  prefix="${prefix/#\~/$HOME}"
  [[ -d "$prefix" ]] || die "prefix not found: $prefix"
  prefix=$(readlink -f "$prefix" 2>/dev/null || echo "$prefix")
  if ((fresh)); then
    ((do_rebuild)) || die "--fresh needs a rebuild; drop --no-rebuild"
    [[ -d "$prefix/drive_c" ]] || die "no drive_c in $(tilde "$prefix"); --fresh refuses to nuke that"
    [[ "$prefix" == "$HOME" || "$prefix" == "/" ]] && die "--fresh refuses to nuke $(tilde "$prefix")"
    local kk
    if ((${#keeps[@]})); then
      for kk in "${keeps[@]}"; do [[ -n "$kk" ]] || die "--keep needs a path (e.g. --keep drive_c/games)"; done
    fi
  else
    [[ -d "$prefix/drive_c" ]] || warn "no drive_c in $(tilde "$prefix"); not clearly a wine prefix"
    ((${#keeps[@]})) && die "--keep only makes sense with --fresh"
  fi
  local arch=""
  if [[ -r "$prefix/system.reg" ]]; then arch=$(grep -m1 '^#arch=' "$prefix/system.reg" | cut -d= -f2); fi
  # current version (probe logic)
  local recorded="" info_ver="" cur_tag="" cur_display="unknown"
  if [[ -r "$prefix/version" ]]; then
    recorded=$(tr -d '[:space:]' < "$prefix/version")
    if [[ "$recorded" =~ ^[0-9]+(GE-Proton.*)$ ]]; then recorded="${BASH_REMATCH[1]}"; fi
  fi
  if [[ -r "$prefix/config_info" ]]; then info_ver=$(head -1 "$prefix/config_info" | tr -d '[:space:]'); fi
  if [[ -n "$recorded" ]]; then cur_tag=$(canonical_tag "$recorded" 2>/dev/null || echo "$recorded"); cur_display="$cur_tag"
  elif [[ -n "$info_ver" ]]; then cur_tag=$(canonical_tag "$info_ver" 2>/dev/null || echo "$info_ver"); cur_display="$cur_tag"
  fi
  local tag
  tag=$(canonical_tag "$target_ver")
  # resolve target proton
  local -a proton_dirs=()
  local root bn rp sym
  while IFS='|' read -r root bn rp sym; do
    [[ -x "$rp/proton" ]] || continue
    proton_dirs+=("$rp")
  done < <(find_ge_dirs "$tag")
  if (( ${#proton_dirs[@]} == 0 )); then
    if ((auto_install)); then
      echo -e "${C}installing${N} $tag for migrate..." >&2
      cmd_install "$tag" || die "auto-install failed for $tag"
      while IFS='|' read -r root bn rp sym; do [[ -x "$rp/proton" ]] || continue; proton_dirs+=("$rp"); done < <(find_ge_dirs "$tag")
      (( ${#proton_dirs[@]} )) || die "proton '$target_ver' ($tag) still not found after install"
    else
      die "proton '$target_ver' ($tag) is not installed (try: pvm install $tag  or  pvm migrate --install $prefix $tag)"
    fi
  fi
  local dir="${proton_dirs[0]}"
  dir=$(readlink -f "$dir" 2>/dev/null || echo "$dir")
  patch_proton_py39 "$dir" 2>/dev/null || true
  # same version check
  if [[ -n "$cur_tag" && "$cur_tag" == "$tag" && $force -eq 0 ]]; then
    echo -e "${G}already${N} on $tag ${D}($(tilde "$prefix"))${N}"
    echo -e "${D}use --force to rebuild anyway${N}"
    return 0
  fi
  # plan
  echo -e "${B}prefix${N}  $(tilde "$prefix")"
  echo -e "${B}arch${N}    ${arch:-unknown}"
  echo -e "${B}from${N}    ${cur_display}"
  echo -e "${B}to${N}      ${G}$tag${N} ${D}-> $(tilde "$dir")${N}"
  echo -e "${B}rebuild${N} $( ((do_rebuild)) && echo "${G}yes (wineboot -u)${N}" || echo "${Y}no (swap files only)${N}" )"
  if ((fresh)); then
    echo -e "${B}mode${N}    ${R}FRESH${N} ${D}nuke prefix, rebuild from scratch, restore saves${N}"
    echo -e "${B}keep${N}    drive_c/users drive_c/ProgramData lutris.json${keeps:+ ${keeps[*]}}"
  fi
  if [[ "$do_backup" == "full" ]]; then echo -e "${B}backup${N}  full tarball"
  elif [[ "$do_backup" == "meta" ]]; then echo -e "${B}backup${N}  meta files (version/config_info/*.reg)"
  else echo -e "${B}backup${N}  ${D}none${N}"; fi
  if ((dry_run)); then
    echo -e "${Y}dry-run${N} ${D}no changes made${N}"
    return 0
  fi
  if (( ! yes )); then
    echo ""
    local ans
    if ((fresh)); then
      read -r -p "NUKE $(tilde "$prefix") and rebuild fresh with $tag (saves preserved)? [y/N] " ans
    else
      read -r -p "migrate $(tilde "$prefix") $cur_display -> $tag ? [y/N] " ans
    fi
    [[ "$ans" == y || "$ans" == Y ]] || { echo "aborted"; return 0; }
  fi
  local ts
  ts=$(date +%Y%m%d-%H%M%S)
  # --- backup ---
  if [[ "$do_backup" != "none" ]]; then
    if [[ "$do_backup" == "full" ]]; then
      local parent base tarball
      parent=$(dirname "$prefix")
      base=$(basename "$prefix")
      tarball="${prefix}.bak.${ts}.tar.gz"
      echo -e "${C}backup${N} ${D}full -> $(tilde "$tarball")${N}" >&2
      if ! tar -czf "$tarball" -C "$parent" "$base" 2>/dev/null; then
        warn "full backup failed, continuing with meta backup"
        do_backup="meta"
      else
        echo -e "${G}backup done${N} ${D}$(du -sh "$tarball" 2>/dev/null | cut -f1)${N}" >&2
      fi
    fi
    if [[ "$do_backup" == "meta" && $fresh -eq 0 ]]; then
      for f in version config_info system.reg user.reg userdef.reg; do
        if [[ -r "$prefix/$f" ]]; then
          cp -a "$prefix/$f" "$prefix/$f.bak.$ts" 2>/dev/null && echo -e "${D}backup${N} $f -> $f.bak.$ts" >&2 || true
        fi
      done
    fi
  fi
  # --- fresh: nuke + rebuild + restore saves ---
  if ((fresh)); then
    cmd_migrate_fresh "$prefix" "$dir" "$tag" "${arch:-win64}" "$ts" "${keeps[@]}"
    # fresh wineboot stamps version itself; enforce it matches target
    local fresh_ver=""
    [[ -r "$prefix/version" ]] && fresh_ver=$(tr -d '[:space:]' < "$prefix/version")
    if [[ -n "$fresh_ver" && "$fresh_ver" != "$tag" ]]; then
      warn "prefix reports '$fresh_ver' (expected $tag); stamping"
      echo "$tag" > "$prefix/version" 2>/dev/null || true
    fi
    echo -e "${G}migrated${N} ${R}fresh${N} ${D}$cur_display${N} ${C}->${N} ${G}$tag${N} ${D}$(tilde "$prefix")${N}"
    return 0
  fi
  # --- rebuild ---
  if ((do_rebuild)); then
    echo -e "${C}rebuilding${N} ${D}wineboot -u in $(tilde "$prefix") with $tag...${N}" >&2
    _run_wineboot_once "$prefix" "$dir" "${arch:-win64}"
    # proton should have updated version/config_info; verify and stamp
    local new_ver="" new_info="" new_tag="" info_tag=""
    if [[ -r "$prefix/version" ]]; then new_ver=$(tr -d '[:space:]' < "$prefix/version"); fi
    if [[ "$new_ver" =~ ^[0-9]+(GE-Proton.*)$ ]]; then new_ver="${BASH_REMATCH[1]}"; fi
    if [[ -r "$prefix/config_info" ]]; then new_info=$(head -1 "$prefix/config_info" | tr -d '[:space:]'); fi
    [[ -n "$new_ver" ]] && new_tag=$(canonical_tag "$new_ver" 2>/dev/null || echo "$new_ver")
    [[ -n "$new_info" ]] && info_tag=$(canonical_tag "$new_info" 2>/dev/null || echo "$new_info")
    if [[ "$new_tag" == "$tag" ]]; then
      # also sync config_info if stale (proton sometimes only updates version)
      if [[ -n "$new_info" && "$info_tag" != "$tag" ]]; then
        echo "$tag" > "$prefix/config_info" 2>/dev/null || true
        echo -e "${D}synced config_info${N} $info_tag ${C}->${N} $tag" >&2
      elif [[ ! -e "$prefix/config_info" ]]; then
        echo "$tag" > "$prefix/config_info" 2>/dev/null || true
      fi
      echo -e "${G}rebuild done${N} ${D}prefix now reports $new_tag${N}" >&2
    elif [[ -n "$new_ver" ]]; then
      warn "prefix version is '$new_ver' (expected $tag) — proton may not have updated it; forcing"
      echo "$tag" > "$prefix/version" 2>/dev/null || true
      echo "$tag" > "$prefix/config_info" 2>/dev/null || true
    else
      echo "$tag" > "$prefix/version" 2>/dev/null || true
      echo "$tag" > "$prefix/config_info" 2>/dev/null || true
      echo -e "${G}rebuild done${N} ${D}stamped version $tag${N}" >&2
    fi
  else
    # no-rebuild: just swap version files
    echo "$tag" > "$prefix/version" 2>/dev/null || warn "failed to write $prefix/version"
    if [[ -e "$prefix/config_info" ]]; then echo "$tag" > "$prefix/config_info" 2>/dev/null || true; fi
    echo -e "${Y}swapped${N} ${D}version files to $tag (no wineboot) — next 'pvm run' will rebuild${N}" >&2
  fi
  echo -e "${G}migrated${N} $cur_display ${C}->${N} ${G}$tag${N} ${D}$(tilde "$prefix")${N}"
}

_help_run() {
  cat <<EOF
${B}pvm run${N} - launch an exe in a prefix the way Lutris does (umu + proton)

  pvm run <prefix> <exe> [args...] [options]

  exe      absolute unix path, or windows-style path (C:\\..., Z:\\...)
  args     anything handed to the game; flags starting with '-' are fine

  options:
    -p, --proton <ver>        force a specific proton instead of the prefix's
                              recorded version
    -a, --appid <id>          steam appid for protonfixes (auto-detected if possible)
        --gameid <id>         full GAMEID (e.g. umu-601150 or umu-default)
    -h, --help                show this help

  appid auto-detection tries: --appid flag, steam_appid.txt next to exe, lutris pga.db (service_id), umu-database.csv

  example:
    pvm run ~/wine-tekken ~/wine-tekken/drive_c/games/foo/foo.exe -fullscreen
    pvm run ~/wine-games "Z:\\install\\game.exe"
    pvm run ~/wine-dmc5 "/media/data/DMC5/DevilMayCry5.exe" --appid 601150
EOF
}

# auto-detect steam appid for protonfixes (steam_appid.txt, lutris pga.db, umu-database)
_detect_appid() {
  local prefix="$1" exe="$2"
  local appid=""
  if [[ -n "$exe" && "$exe" == /* ]]; then
    local d
    d="$(dirname "$exe")"
    for i in 1 2 3 4; do
      if [[ -r "$d/steam_appid.txt" ]]; then
        appid="$(tr -cd '0-9' < "$d/steam_appid.txt" 2>/dev/null | head -c 12)"
        [[ "$appid" =~ ^[0-9]{2,10}$ ]] && { echo "$appid"; return 0; }
      fi
      [[ "$d" == "/" || "$d" == "." ]] && break
      d="$(dirname "$d")"
    done
  fi
  local pga="$HOME/.local/share/lutris/pga.db"
  if [[ -f "$pga" ]] && command -v sqlite3 &>/dev/null; then
    local exe_esc="${exe//\'/\'\'}"
    local pfx_esc="${prefix//\'/\'\'}"
    appid="$(sqlite3 -separator '|' "$pga" "SELECT service_id FROM games WHERE service='steam' AND service_id GLOB '[0-9]*' AND (executable LIKE '%$exe_esc%' OR directory LIKE '%$pfx_esc%' OR configpath IN (SELECT configpath FROM games WHERE configpath LIKE '%$(basename "$prefix" 2>/dev/null)%')) LIMIT 1;" 2>/dev/null | tr -cd '0-9' | head -c 12)"
    if [[ "$appid" =~ ^[0-9]{2,10}$ ]]; then echo "$appid"; return 0; fi
    if [[ -n "$exe" ]]; then
      local lut_games="$HOME/.local/share/lutris/games"
      if [[ -d "$lut_games" ]]; then
        local yml
        for yml in "$lut_games"/*.yml; do
          [[ -f "$yml" ]] || continue
          if grep -Fq "$exe" "$yml" 2>/dev/null; then
            local slug
            slug="$(basename "$yml" | sed -E 's/-[0-9]+\.yml$//')"
            appid="$(sqlite3 "$pga" "SELECT service_id FROM games WHERE slug='$slug' AND service='steam' AND service_id GLOB '[0-9]*' LIMIT 1;" 2>/dev/null | tr -cd '0-9' | head -c 12)"
            [[ "$appid" =~ ^[0-9]{2,10}$ ]] && { echo "$appid"; return 0; }
          fi
        done
      fi
    fi
  fi
  local umu_db=""
  for cand in "$HOME/.local/share/umu/umu-database.csv" "$HOME/.cache/umu/umu-database.csv" "/usr/share/umu/umu-database.csv"; do
    [[ -r "$cand" ]] && umu_db="$cand" && break
  done
  if [[ -n "$umu_db" && -n "$exe" ]]; then
    local base
    base="$(basename "$exe" | tr '[:upper:]' '[:lower:]')"
    appid="$(grep -i -m1 "$base" "$umu_db" 2>/dev/null | awk -F',' '{for(i=1;i<=NF;i++) if($i ~ /^[0-9]{2,10}$/) {print $i; exit}}' | tr -cd '0-9' | head -c 12)"
    [[ "$appid" =~ ^[0-9]{2,10}$ ]] && { echo "$appid"; return 0; }
  fi
  return 1
}

# --- run: launch an exe in a prefix exactly like Lutris (umu + proton) ---
cmd_run() {
  local proton_ver="" prefix="" exe="" appid="" gameid=""
  local -a args=()
  # Known pvm flags are recognized anywhere; anything else (including game
  # flags like -fullscreen) is positional. Use '--' to force everything after
  # it to be positional/args, so a game flag can't be mistaken for exe.
  while (($#)); do
    case "$1" in
    -h | --help)
      _help_run
      return
      ;;
    --)
      shift
      # everything after '--' is positional (prefix/exe/args)
      while (($#)); do
        if [[ -z "$prefix" ]]; then
          prefix="$1"
        elif [[ -z "$exe" ]]; then
          exe="$1"
        else
          args+=("$1")
        fi
        shift
      done
      break
      ;;
    -a | --appid)
      appid="${2:-}"
      shift 2
      ;;
    --appid=*)
      appid="${1#*=}"
      shift
      ;;
    --gameid=*)
      gameid="${1#*=}"
      shift
      ;;
    --gameid)
      gameid="${2:-}"
      shift 2
      ;;
    --umu-id=*)
      appid="${1#*=}"
      appid="${appid#umu-}"
      shift
      ;;
    --umu-id)
      appid="${2:-}"
      appid="${appid#umu-}"
      shift 2
      ;;
    -p | --proton)
      proton_ver="${2:-}"
      shift 2
      ;;
    --proton=*)
      proton_ver="${1#*=}"
      shift
      ;;
    -*)
      # unknown flag: only legal as a game arg once the exe is set
      if [[ -n "$exe" ]]; then
        args+=("$1")
        shift
      else
        die "unknown flag '$1'"
      fi
      ;;
    *)
      if [[ -z "$prefix" ]]; then
        prefix="$1"
      elif [[ -z "$exe" ]]; then
        exe="$1"
      else
        args+=("$1")
      fi
      shift
      ;;
    esac
  done
  [[ -z "$prefix" ]] && die "give a prefix dir (pvm run <prefix> <exe>)"
  [[ -z "$exe" ]] && die "give an exe (pvm run <prefix> <exe>)"

  prefix="${prefix/#\~/$HOME}"
  [[ -d "$prefix" ]] || die "prefix not found: $prefix"
  prefix=$(readlink -f "$prefix" 2>/dev/null || echo "$prefix")

  # --- resolve which proton to use ---
  local ver=""
  if [[ -n "$proton_ver" ]]; then
    ver="$proton_ver"
  elif [[ -r "$prefix/version" ]]; then
    ver=$(tr -d '[:space:]' < "$prefix/version")
    [[ "$ver" =~ ^[0-9]+(GE-Proton.*)$ ]] && ver="${BASH_REMATCH[1]}"
  fi
  [[ -z "$ver" ]] && die "no proton version recorded in $(tilde "$prefix"); pass --proton <ver>"

  local tag="" dir=""
  tag=$(canonical_tag "$ver")
  local -a proton_dirs=()
  while IFS='|' read -r root bn rp sym; do
    [[ -x "$rp/proton" ]] || continue
    proton_dirs+=("$rp")
  done < <(find_ge_dirs "$tag")
  ((${#proton_dirs[@]})) || die "proton '$ver' ($tag) is not installed"
  dir="${proton_dirs[0]}"
  echo -e "${C}proton${N} ${G}$ver${N} ${D}-> $(tilde "$dir")${N}" >&2
  # py3.9 compat: auto-heal broken vulkan.py before launching
  patch_proton_py39 "$(readlink -f "$dir")" 2>/dev/null || true

  # --- locate umu-run ---
  local umu=""
  umu=$(command -v umu-run 2>/dev/null || true)
  if [[ -z "$umu" ]]; then
    local cand
    for cand in "$HOME/.local/share/lutris/runtime/umu/umu-run" "/usr/local/share/umu/umu-run" "/usr/share/umu/umu-run" "/opt/umu/umu-run"; do
      [[ -x "$cand" ]] && umu="$cand" && break
    done
  fi
  [[ -z "$umu" ]] && die "umu-run not found; install umu-launcher or let Lutris provision it"
  echo -e "${C}umu${N}    $(tilde "$umu")" >&2

  # --- resolve the exe (mimic Lutris get_real_executable) ---
  local windows_like=0
  if [[ "$exe" =~ ^[A-Za-z]: ]] || [[ "$exe" == *\\* ]]; then
    windows_like=1
  fi
  if ((!windows_like)) && [[ "$exe" != /* ]]; then
    # relative unix path: resolve against CWD so umu, appid detect, and cwd all see the real file
    local resolved
    resolved=$(readlink -f "$exe" 2>/dev/null || realpath -m "$exe" 2>/dev/null || echo "$exe")
    if [[ -f "$resolved" ]]; then
      echo -e "${D}exe${N}  ${D}$exe -> $(tilde "$resolved")${N}" >&2
      exe="$resolved"
    else
      warn "exe is not an absolute path and '$exe' does not resolve; umu may not find it"
    fi
  fi
  local -a lexe=()
  case "$(basename "$exe" | tr '[:upper:]' '[:lower:]')" in
  *.msi) lexe=(msiexec /i "$exe") ;;
  *.bat | *.cmd) lexe=(cmd /C "$exe") ;;
  *.lnk) lexe=(start /unix "$exe") ;;
  *) lexe=("$exe") ;;
  esac
  if ((!windows_like)); then
    [[ -f "$exe" ]] || warn "exe not found: $exe"
  fi

  # --- env (mirrors Lutris get_env + finish_env + update_proton_env) ---
  local resolved_gameid=""
  if [[ -n "$gameid" ]]; then
    resolved_gameid="$gameid"
  elif [[ -n "$appid" ]]; then
    appid="$(tr -cd '0-9' <<<"$appid" | head -c 12)"
    if [[ "$appid" =~ ^[0-9]{2,10}$ ]]; then
      resolved_gameid="umu-$appid"
    else
      warn "invalid --appid '$appid', using auto-detect"
      appid=""
    fi
  fi
  if [[ -z "$resolved_gameid" ]]; then
    local auto_appid
    if auto_appid="$(_detect_appid "$prefix" "$exe" 2>/dev/null)"; then
      resolved_gameid="umu-$auto_appid"
      echo -e "${D}appid${N}  ${G}$auto_appid${N} ${D}auto-detected -> $resolved_gameid${N}" >&2
    else
      resolved_gameid="umu-default"
    fi
  fi
  local -a env=()
  env+=("WINEARCH=win64")
  env+=("WINEPREFIX=$prefix")
  env+=("PROTONPATH=$dir")
  env+=("GAMEID=$resolved_gameid")
  env+=("PROTON_VERB=waitforexitandrun")
  [[ -z "${WINEDEBUG:-}" ]] && env+=("WINEDEBUG=-all")
  [[ -z "${DXVK_LOG_LEVEL:-}" ]] && env+=("DXVK_LOG_LEVEL=error")
  [[ -z "${UMU_LOG:-}" ]] && env+=("UMU_LOG=1")
  [[ -z "${WINEESYNC:-}" ]] && env+=("WINEESYNC=1")
  [[ -z "${WINEFSYNC:-}" ]] && env+=("WINEFSYNC=1")
  [[ -z "${WINE_LARGE_ADDRESS_AWARE:-}" ]] && env+=("WINE_LARGE_ADDRESS_AWARE=1")
  [[ -z "${WINE_FULLSCREEN_FSR:-}" ]] && env+=("WINE_FULLSCREEN_FSR=1")
  [[ -z "${WINE_FULLSCREEN_FSR_STRENGTH:-}" ]] && env+=("WINE_FULLSCREEN_FSR_STRENGTH=2")
  if [[ -d "$dir/files/mono" ]]; then env+=("WINE_MONO_CACHE_DIR=$dir/files/mono"); fi
  if [[ -d "$dir/files/gecko" ]]; then env+=("WINE_GECKO_CACHE_DIR=$dir/files/gecko"); fi
  [[ -z "${WINEDLLOVERRIDES:-}" ]] && env+=("WINEDLLOVERRIDES=winemenubuilder=")
  [[ -n "${LC_ALL:-}" && -z "${HOST_LC_ALL:-}" ]] && env+=("HOST_LC_ALL=$LC_ALL")

  local cwd=""
  if ((!windows_like)) && [[ "$exe" == /* ]]; then cwd=$(dirname "$exe"); fi

  echo -e "${C}run${N}     ${G}$exe${N} ${D}in $(tilde "$prefix")${N}" >&2
  [[ -n "$cwd" ]] && cd "$cwd" 2>/dev/null || true
  exec env "${env[@]}" "$umu" "${lexe[@]}" "${args[@]}"
}

cmd_help() {
  cat <<EOF
${B}pvm${N} - Proton Version Manager ${D}${N}

  ${C}play${N}
    run <prefix> <exe>   launch an exe in a prefix like Lutris (umu + proton)

  ${C}local${N}
    l, ls, list      list installed versions across steam + lutris
    use <ver>     switch active version (lutris ge-proton symlink)
    probe <prefix>    report which proton/wine/ge version a prefix was built with
    migrate <prefix> <ver>  change and rebuild prefix to another version ${D}[--backup --no-rebuild --fresh]${N}
    r, rm, remove    remove version(s)          ${D}[-y --force]${N}
    prune            dedupe lutris (real copies -> symlinks)
    link, sync       ensure steam versions are symlinked in lutris
    patch, fix       fix py3.9 compat for GE-Proton 11.5+ (vulkan.py Self)

  ${C}remote${N}
    s, search [query]   search GitHub releases     ${D}[--limit N --json]${N}
    i, install <ver>    download specific version  ${D}[--arch --reinstall]${N}
    u, update        update to latest release

  ${D}version args:${N} '11-5' or 'GE-Proton11-5' or 'GE-Proton11-5-x86_64' or 'latest'
  ${D}paths:${N}
    steam:  $(tilde "$STEAM_ROOT")
    lutris: $(tilde "$LUTRIS_ROOT")
    active: $(tilde "$ACTIVE_PATH") -> $(tilde "$(readlink -f "$ACTIVE_PATH" 2>/dev/null || echo "none")")
EOF
}

# ================= main =================
[[ -d "$STEAM_ROOT" ]] || die "steam compat dir not found: $STEAM_ROOT (tried $STEAM_HOME and ~/.steam/steam/compatibilitytools.d)"

case "${1:-help}" in
u | update)
  shift
  cmd_update "$@"
  ;;
l | ls | list)
  shift
  cmd_list "$@"
  ;;
p | prune | dedupe)
  shift
  cmd_prune "$@"
  ;;
link | sync)
  shift
  cmd_link "$@"
  ;;
r | rm | remove)
  shift
  cmd_remove "$@"
  ;;
probe | which | info)
  shift
  cmd_probe "$@"
  ;;
migrate | change | set | prefix | set-prefix | migrate-prefix)
  shift
  cmd_migrate "$@"
  ;;
use | activate)
  shift
  cmd_use "$@"
  ;;
run)
  shift
  cmd_run "$@"
  ;;
s | search | find | query)
  shift
  cmd_search "$@"
  ;;
i | install | get | download | fetch | add)
  shift
  cmd_install "$@"
  ;;
fix | patch | heal)
  shift
  cmd_patch "$@"
  ;;
version | --version | -v) echo "pvm 2.0.0 (geman successor)" ;;
*) cmd_help ;;
esac
