#!/usr/bin/env bash
# arcctl - Intel Arc A350M (DG2) power control for the ASUS Vivobook S15 (K5504VN)
#
# The dGPU is headless (panel lives on the iGPU). Left always-on it leeches ~14W
# idle and triggers a freeze bug. It's removed from the PCI bus to fix both.
#
# Flags:
#   status            show whether the Arc is present + udev rule state
#   persist-off       write udev rule -> Arc removed at every boot (default)
#   persist-on        park udev rule   -> Arc present at every boot
#   remove            detach the Arc NOW (unbind + remove), no udev change
#   rescan            re-enumerate the PCI bridge NOW, no udev change
# -------------------------------------------------------------------------

# Arc A350M (dg2). Its PCI BDF is NOT stable: a firmware change (came with a
# Windows reinstall) moved it from 0000:03:00.0 to 0000:04:00.0. Resolve it by
# device ID every run so a future shuffle can't silently break this script.
ARC_DEVID="0x5694"

find_arc() {
  for d in /sys/bus/pci/devices/*; do
    [ -f "$d/device" ] && [ "$(cat "$d/device")" = "$ARC_DEVID" ] && { basename "$d"; return 0; }
  done
  return 1
}

find_bridge() { # bridge whose secondary bus owns the card's bus
  [ -n "$DEV" ] || return 1
  local bus="${DEV#*:}"; bus="${bus%%:*}"
  bus=$(printf '%d' "0x$bus")
  for b in /sys/bus/pci/devices/*; do
    [ -f "$b/secondary_bus_number" ] && [ "$(cat "$b/secondary_bus_number")" = "$bus" ] && { basename "$b"; return 0; }
  done
  return 1
}

DEV="$(find_arc)"       # empty when the card is absent
BRIDGE="$(find_bridge)" # empty when the card is absent
DPATH="/sys/bus/pci/devices/$DEV"

RULE="/etc/udev/rules.d/99-disable-arc.rules"
RULE_OFF="${RULE}.off"
RULE_BODY='ACTION=="add", SUBSYSTEM=="pci", ATTR{device}=="0x5694", ATTR{power/control}="auto", ATTR{remove}="1"'

# All sysfs/udev paths are root-only.
if [ "$(id -u)" -ne 0 ]; then
  exec sudo "$0" "$@"
fi

card_present() { [ -n "$DEV" ] && [ -e "$DPATH" ]; }

rule_state() {
  if [ -f "$RULE" ]; then
    grep -q '0x5694' "$RULE" 2>/dev/null && echo "persisted OFF" || echo "stale (not our rule)"
  elif [ -f "$RULE_OFF" ]; then
    echo "persisted ON"
  else
    echo "absent"
  fi
}

# --- commands ---------------------------------------------------------------

case "${1:-status}" in

status | s)
  echo "card:   $(card_present && echo PRESENT || echo GONE)"
  driver=""; if card_present; then link=$(readlink "$DPATH/driver" 2>/dev/null); [ -n "$link" ] && driver=$(basename "$link") || driver="none"; else driver="none"; fi; echo "driver: $driver"
  echo "rule:   $(rule_state)"
  ;;

persist-off | po) # Arc removed at every boot
  printf '%s\n' "$RULE_BODY" >"$RULE"
  rm -f "$RULE_OFF"
  udevadm control --reload-rules 2>/dev/null
  echo "udev rule ACTIVE - Arc will be removed at boot"
  ;;

persist-on | pn) # Arc present at every boot
  if [ -f "$RULE" ]; then
    mv "$RULE" "$RULE_OFF"
    udevadm control --reload-rules 2>/dev/null
  fi
  echo "udev rule PARKED - Arc will be present at boot"
  ;;

remove | r) # detach the Arc this session only
  if ! card_present; then
    echo "card already gone"
    exit 1
  fi
  echo "$DEV" >/sys/bus/pci/drivers/i915/unbind 2>/dev/null
  echo "$DEV" >/sys/bus/pci/drivers/xe/unbind 2>/dev/null
  printf '1' >"$DPATH/remove" 2>/dev/null
  if card_present; then
    echo "!! failed to remove card" >&2
    exit 1
  fi
  echo "card removed"
  ;;

rescan | rs) # re-enumerate the PCI bridge this session only
  echo 1 >"/sys/bus/pci/devices/$BRIDGE/rescan" 2>/dev/null
  sleep 2
  if ! card_present; then
    echo "bridge found nothing, rescanning whole bus..."
    echo 1 >/sys/bus/pci/rescan 2>/dev/null
    sleep 2
  fi
  if card_present && [ -z "$(readlink "$DPATH/driver" 2>/dev/null)" ]; then
    grep -q i915 /proc/modules 2>/dev/null && echo "$DEV" >/sys/bus/pci/drivers/i915/bind 2>/dev/null
  fi
  echo "card: $(card_present && echo PRESENT || echo GONE)"
  ;;

*)
  echo "usage: $0 {status|persist-off|persist-on|remove|rescan}"
  echo "  s / status    card presence + udev rule state"
  echo "  po/ persist-off   remove Arc at every boot"
  echo "  pn/ persist-on    keep Arc at every boot"
  echo "  r / remove    detach Arc now (this session)"
  echo "  rs/ rescan    re-enumerate PCI bridge now (this session)"
  ;;
esac
