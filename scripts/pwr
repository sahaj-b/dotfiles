#!/usr/bin/env bash

set -euo pipefail

# Self-elevate for write operations
if [[ $EUID -ne 0 ]]; then
  case "${1:-}" in
  g | 0 | 1 | 2 | 3 | max | saver | light | balanced | bal | b | performance | perf | p | rapl | gpu | epp | gov | aspm | wifi | sound | bt | turbo | pp | pp-auto | irq)
    exec sudo "$0" "$@"
    ;;
  esac
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# Paths — RAPL zones/constraints are DISCOVERED at apply time, not hardcoded:
# constraint names (long_term/short_term) exist since kernel 3.13, Meteor Lake
# registers an MSR (intel-rapl:0) AND a TPMI/MMIO (intel-rapl-mmio:0) package
# zone, and AMD exposes no writable constraints at all. GPU card index is not
# identity either.
CPU_EPP="/sys/devices/system/cpu/cpufreq/policy0/energy_performance_preference"
CPU_EPP_AVAIL="/sys/devices/system/cpu/cpufreq/policy0/energy_performance_available_preferences"
CPU_GOV="/sys/devices/system/cpu/cpufreq/policy0/scaling_governor"
CPU_GOV_AVAIL="/sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors"
GPU_MAX=""
GPU_CUR=""
GPU_MIN=""
PCIE_ASPM="/sys/module/pcie_aspm/parameters/policy"
SOUND_PM="/sys/module/snd_hda_intel/parameters/power_save"
CPU_FREQ_CUR="/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq"
NO_TURBO="/sys/devices/system/cpu/intel_pstate/no_turbo"
PLATFORM_PROFILE="/sys/firmware/acpi/platform_profile"
PLATFORM_PROFILE_AVAIL="/sys/firmware/acpi/platform_profile_choices"
BAT_LIMIT="/sys/class/power_supply/BAT0/charge_control_end_threshold"
BAT_STATE="/var/lib/pwr/bat_limit"
BAT_STATE_DIR="/var/lib/pwr"
BAT_RULE="/etc/udev/rules.d/99-pwr-battery.rules"
BAT_RULE_OFF="${BAT_RULE}.off"
BAT_SERVICE="/usr/lib/systemd/system/pwr-battery-restore.service"
PP_AC="/var/lib/pwr/pp_ac"
PP_DC="/var/lib/pwr/pp_dc"
PP_RULE="/etc/udev/rules.d/99-pwr-pp.rules"
PP_RULE_OFF="${PP_RULE}.off"

ok() { echo -e "  ${GREEN}✓${NC} $*"; }
warn() { echo -e "  ${YELLOW}!${NC} $*"; }
info() { echo -e "  ${CYAN}→${NC} $*"; }
hr() { echo -e "${DIM}$(printf '%.0s─' {1..50})${NC}"; }

write() { echo "$2" >"$1" 2>/dev/null; }
read_safe() { cat "$1" 2>/dev/null || echo "N/A"; }
to_watts() { [[ "$1" =~ ^[0-9]+$ ]] && echo $(($1 / 1000000)) || echo "?"; }
to_mhz() { [[ "$1" =~ ^[0-9]+$ ]] && echo $(($1 / 1000)) || echo "?"; }
turbo_state() {
  local v
  v=$(read_safe "$NO_TURBO")
  [[ "$v" == "0" ]] && echo on || { [[ "$v" == "1" ]] && echo off || echo "?"; }
}

# `list` menu rows — highlight the active option, dim the rest.
menu_highlight() { # <label> <current> <option...>
  local label="$1" cur="$2" out="" o
  shift 2
  for o in "$@"; do
    if [[ "$o" == "$cur" ]]; then
      out+="${GREEN}${o}${NC} "
    else
      out+="${DIM}${o}${NC} "
    fi
  done
  printf "  ${BOLD}%s${NC}%*s%b\n" "$label" $((10 - ${#label})) "" "$out"
}

# Apply functions

# RAPL: package-0 zones only (the "package power limits" this tool manages).
# MTL has two package zones (MSR + TPMI/MMIO) — we write ALL of them so both
# interfaces stay consistent. max=0 means "no max exposed", not "max is 0".
RAPL_CONSTRAINTS=() # "<limit_path> <label>"

find_rapl() {
  local z c base idx lbl cname
  RAPL_CONSTRAINTS=()
  for z in /sys/class/powercap/*/; do
    [[ "$(basename "$z")" == *rapl* ]] || continue
    [[ "$(read_safe "$z/name")" == "package-0" ]] || continue
    for c in "$z"constraint_*_power_limit_uw; do
      [[ -e "$c" ]] || continue
      base=${c%_power_limit_uw}
      idx=${c##*constraint_}
      idx=${idx%%_*}
      cname=$(read_safe "${base}_name")
      case "$cname" in
      long_term) lbl=PL1 ;;
      short_term) lbl=PL2 ;;
      *) lbl="C$idx" ;;
      esac
      RAPL_CONSTRAINTS+=("$c $lbl")
    done
  done
}

write_rapl() { # <label> <watts> — every package zone exposing that label
  local label="$1" watts="$2" e path base max wrote=0 failed=0 pshort w
  for e in "${RAPL_CONSTRAINTS[@]}"; do
    [[ "${e##* }" == "$label" ]] || continue
    path=${e% *}
    base=${path%_power_limit_uw}
    max=$(read_safe "${base}_max_power_uw")
    w=$watts
    if [[ "$max" =~ ^[0-9]+$ ]] && ((max > 0)) && ((w * 1000000 > max)); then
      w=$((max / 1000000))
      warn "$label clamped to ${w}W (hw max)"
    fi
    if write "$path" "$((w * 1000000))"; then
      wrote=$((wrote + 1))
      pshort=${path#/sys/class/powercap/}
      pshort=${pshort%%/*}
      ok "$label → ${w}W ($pshort)"
    else
      failed=$((failed + 1))
      pshort=${path#/sys/class/powercap/}
      pshort=${pshort%%/*}
      warn "$label write failed ($pshort)"
    fi
  done
  ((wrote)) || return 1
  return 0
}

apply_rapl() {
  find_rapl
  ((${#RAPL_CONSTRAINTS[@]})) || {
    warn "RAPL unsupported (no writable package zone)"
    return 0
  }
  write_rapl PL1 "$1" || warn "No PL1 constraint exposed"
  write_rapl PL2 "$2" || warn "No PL2 constraint exposed"
}

# IMPORTANT: powersave is actually auto-balance-load type shi, and performance locks CPU to max freq(overrides EPP)
apply_governor() {
  local gov="$1" g fail=0 n=0 now
  if [[ -r "$CPU_GOV_AVAIL" ]]; then
    grep -qw "$gov" "$CPU_GOV_AVAIL" || {
      warn "Governor '$gov' not offered — available: $(read_safe "$CPU_GOV_AVAIL")"
      return 1
    }
  else
    warn "cpufreq not exposed — skipping governor"
    return 0
  fi
  for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
    if write "$g" "$gov"; then n=$((n + 1)); else fail=$((fail + 1)); fi
  done
  now=$(read_safe "$CPU_GOV")
  if ((fail)); then
    warn "Governor → $gov: $n ok, $fail failed (reads $now)"
  else
    ok "Governor → $gov (${n} policies)"
    [[ "$now" == "$gov" ]] || warn "Read-back mismatch: $now"
  fi
}

apply_epp() {
  local epp="$1" p fail=0 n=0 now
  if [[ -r "$CPU_EPP_AVAIL" ]]; then
    grep -qw "$epp" "$CPU_EPP_AVAIL" || {
      warn "EPP '$epp' not offered — available: $(read_safe "$CPU_EPP_AVAIL")"
      return 1
    }
  else
    warn "EPP not exposed (no HWP) — skipping"
    return 0
  fi
  for p in /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference; do
    if write "$p" "$epp"; then n=$((n + 1)); else fail=$((fail + 1)); fi
  done
  now=$(read_safe "$CPU_EPP")
  if ((fail)); then
    warn "EPP → $epp: $n ok, $fail failed (reads $now)"
  else
    ok "EPP → $epp (${n} policies)"
    [[ "$now" == "$epp" ]] || warn "Read-back mismatch: $now"
  fi
}

apply_pcie_aspm() {
  local mode="$1" opts
  opts=$(tr -d '[]' <"$PCIE_ASPM" 2>/dev/null)
  grep -qw "$mode" <<<"$opts" || {
    warn "Invalid ASPM mode '$mode' — available: $opts"
    return 1
  }
  write "$PCIE_ASPM" "$mode" && ok "PCIe ASPM → $mode" || warn "PCIe ASPM write failed"
}

# i915/xe cards expose gt_*_freq_mhz; card index is not identity — prefer the
# display card (PCI class 0x0300) over a dGPU (0x0302), fall back to any GT card.
find_gpu() {
  local c class
  GPU_MAX=""
  GPU_MIN=""
  GPU_CUR=""
  for c in /sys/class/drm/card[0-9]*/gt_max_freq_mhz; do
    class=$(read_safe "${c%/gt_max_freq_mhz}/device/class")
    if [[ "$class" == 0x0300* ]]; then
      GPU_MAX="$c"
      GPU_CUR="${c/gt_max_freq_mhz/gt_cur_freq_mhz}"
      GPU_MIN="${c/gt_max_freq_mhz/gt_min_freq_mhz}"
      return 0
    fi
  done
  for c in /sys/class/drm/card[0-9]*/gt_max_freq_mhz; do
    GPU_MAX="$c"
    GPU_CUR="${c/gt_max_freq_mhz/gt_cur_freq_mhz}"
    GPU_MIN="${c/gt_max_freq_mhz/gt_min_freq_mhz}"
    return 0
  done
  return 1
}

apply_gpu() {
  local freq="$1" now
  find_gpu || {
    warn "No Intel GT card found"
    return 1
  }
  write "$GPU_MAX" "$freq" && ok "GPU max → ${freq} MHz" || warn "GPU max write failed"
  now=$(read_safe "$GPU_MAX")
  [[ "$now" == "$freq" ]] || warn "Read-back mismatch: $now"
}

wifi_ifaces() { iw dev 2>/dev/null | awk '/^[[:space:]]*Interface/{print $2}'; }

wifi_power_state() { # on/off/? from the first interface that reports
  local i ps
  for i in $(wifi_ifaces); do
    ps=$(iw dev "$i" get power_save 2>/dev/null | grep -oP '(on|off)' | head -1)
    [[ -n "$ps" ]] && {
      echo "$ps"
      return 0
    }
  done
  echo "?"
}

apply_wifi_power() {
  local state="$1" i n=0 fail=0
  local -a ifs=()
  read -ra ifs <<<"$(wifi_ifaces)"
  ((${#ifs[@]})) || {
    warn "No wifi interface found"
    return 1
  }
  for i in "${ifs[@]}"; do
    if iw dev "$i" set power_save "$state" 2>/dev/null; then n=$((n + 1)); else fail=$((fail + 1)); fi
  done
  if ((fail)); then
    warn "WiFi power save → $state: $n ok, $fail failed"
  else
    ok "WiFi power save → $state (${ifs[*]})"
  fi
}

apply_sound_pm() {
  local val="$1"
  [[ "$val" =~ ^[0-9]+$ ]] || {
    warn "Sound PM must be a number (seconds timeout)"
    return 1
  }
  write "$SOUND_PM" "$val" && ok "Sound PM → ${val}s" || warn "Sound PM write failed"
}

apply_turbo() {
  local state="$1" want now b fail=0 n=0
  want=0
  [[ "$state" == "off" ]] && want=1
  if [[ -f "$NO_TURBO" ]]; then
    write "$NO_TURBO" "$want" && ok "Turbo → $state" || warn "Turbo write failed"
    now=$(read_safe "$NO_TURBO")
    [[ "$now" == "$want" ]] || warn "Read-back mismatch: $now"
  elif compgen -G "/sys/devices/system/cpu/cpufreq/policy*/boost" >/dev/null; then
    for b in /sys/devices/system/cpu/cpufreq/policy*/boost; do
      if write "$b" "$want"; then n=$((n + 1)); else fail=$((fail + 1)); fi
    done
    ((fail)) && warn "Turbo → $state (boost): $n ok, $fail failed" || ok "Turbo → $state (boost, ${n} policies)"
  else
    warn "Turbo control not exposed on this system"
  fi
}

# IMPORTANT: This can change shi like epp/freq/etc, depending on the lappy, on mine it changes the EPP. you can manually check it for urs.
apply_platform_profile() {
  local prof="$1"
  if [[ -f "$PLATFORM_PROFILE" ]]; then
    grep -qw "$prof" <<<"$(read_safe "$PLATFORM_PROFILE_AVAIL")" || {
      warn "Profile '$prof' not offered — available: $(read_safe "$PLATFORM_PROFILE_AVAIL")"
      return 1
    }
    write "$PLATFORM_PROFILE" "$prof" && ok "Platform profile → $prof" || warn "Platform profile write failed"
  else
    warn "Platform profile not supported"
  fi
}

apply_bat_limit() {
  local limit="$1"
  mkdir -p "$BAT_STATE_DIR" 2>/dev/null
  write "$BAT_LIMIT" "$limit" && ok "Charge limit → ${limit}%" || warn "Charge limit write failed"
}

bat_restore() {
  if [[ -f "$BAT_STATE" ]]; then
    apply_bat_limit "$(cat "$BAT_STATE")"
  else
    warn "No saved charge limit"
  fi
}

bat_install() {
  local self
  self=$(readlink -f "$0")
  mkdir -p "$(dirname "$BAT_RULE")" 2>/dev/null
  printf 'SUBSYSTEM=="power_supply", ACTION=="change", ATTR{type}=="Mains", ATTR{online}=="0", RUN+="%s bat restore"\n' "$self" >"$BAT_RULE"
  printf '[Unit]\nDescription=Re-apply pwr battery charge limit at boot\nAfter=multi-user.target\n\n[Service]\nType=oneshot\nExecStart=%s bat restore\nRemainAfterExit=no\n\n[Install]\nWantedBy=multi-user.target\n' "$self" >"$BAT_SERVICE"
  rm -f "$BAT_RULE_OFF"
  udevadm control --reload-rules 2>/dev/null
  systemctl daemon-reload 2>/dev/null
  systemctl enable pwr-battery-restore.service >/dev/null 2>&1 || true
  ok "udev rule + boot service installed (→ $BAT_RULE)"
}

bat_uninstall() {
  rm -f "$BAT_RULE" "$BAT_RULE_OFF"
  systemctl disable pwr-battery-restore.service >/dev/null 2>&1 || true
  rm -f "$BAT_SERVICE"
  udevadm control --reload-rules 2>/dev/null || true
  ok "udev rule + boot service removed"
}

pp_rule_state() {
  if [[ -f "$PP_RULE" ]]; then
    echo "active"
  elif [[ -f "$PP_RULE_OFF" ]]; then
    echo "off (.off)"
  else
    echo "absent"
  fi
}

pp_epp_for() {
  case "$1" in
  performance) echo performance ;;
  balanced) echo balance_power ;;
  quiet) echo power ;;
  *) echo balance_power ;;
  esac
}

pp_install() {
  local self
  self=$(readlink -f "$0")
  mkdir -p "$(dirname "$PP_RULE")" 2>/dev/null
  printf 'SUBSYSTEM=="power_supply", ACTION=="change", ATTR{type}=="Mains", ATTR{online}=="1", RUN+="%s pp-auto ac"\nSUBSYSTEM=="power_supply", ACTION=="change", ATTR{type}=="Mains", ATTR{online}=="0", RUN+="%s pp-auto dc"\n' "$self" "$self" >"$PP_RULE"
  rm -f "$PP_RULE_OFF"
  udevadm control --reload-rules 2>/dev/null || true
  ok "pp udev rule installed (→ $PP_RULE)"
}

pp_uninstall() {
  rm -f "$PP_RULE" "$PP_RULE_OFF"
  udevadm control --reload-rules 2>/dev/null || true
  ok "pp udev rule removed"
}

cmd_pp() {
  local sub="${1:-}" val="${2:-}"
  case "$sub" in
  ac | dc)
    [[ -n "$val" ]] || {
      echo "Usage: pwr pp $sub <profile>"
      exit 1
    }
    grep -qw "$val" <<<"$(read_safe "$PLATFORM_PROFILE_AVAIL")" || {
      warn "Invalid profile '$val' — available: $(read_safe "$PLATFORM_PROFILE_AVAIL")"
      exit 1
    }
    mkdir -p "$BAT_STATE_DIR" 2>/dev/null
    local f
    [[ "$sub" == ac ]] && f="$PP_AC" || f="$PP_DC"
    echo "$val" >"$f"
    pp_install
    ok "Auto profile on $sub → $val"
    ;;
  auto)
    case "$val" in
    install) pp_install ;;
    uninstall) pp_uninstall ;;
    *) cmd_pp_status ;;
    esac
    ;;
  status)
    cmd_pp_status
    ;;
  *)
    [[ -n "$sub" ]] || {
      echo "Usage: pwr pp <profile|ac|dc|auto|status>"
      exit 1
    }
    grep -qw "$sub" <<<"$(read_safe "$PLATFORM_PROFILE_AVAIL")" || {
      warn "Invalid profile '$sub' — available: $(read_safe "$PLATFORM_PROFILE_AVAIL")"
      exit 1
    }
    apply_platform_profile "$sub"
    ;;
  esac
}

cmd_pp_status() {
  echo -e "  Auto profiles:  ac=${CYAN}$(read_safe "$PP_AC")${NC}  dc=${CYAN}$(read_safe "$PP_DC")${NC}"
  echo -e "  PP hook:        ${CYAN}$(pp_rule_state)${NC}"
  echo -e "  EPP mapping:    quiet→power  balanced→balance_power  performance→performance"
}

cmd_pp_auto() {
  local state="${1:-}" f prof
  case "$state" in
  ac) f="$PP_AC" ;;
  dc) f="$PP_DC" ;;
  *)
    echo "Usage: pwr pp-auto <ac|dc>"
    exit 1
    ;;
  esac
  if [[ ! -f "$f" ]]; then
    warn "No auto profile set for $state — run 'pwr pp $state <profile>'"
    exit 1
  fi
  prof=$(cat "$f")
  apply_platform_profile "$prof"
  apply_epp "$(pp_epp_for "$prof")"
}

cmd_bat() {
  local arg="${1:-}"
  # Mutating subcommands self-elevate; bare `pwr bat` just reads the limit.
  case "$arg" in
  full | oneshot | o | install | uninstall | restore | [0-9]*)
    [[ $EUID -ne 0 ]] && exec sudo "$0" bat "$arg"
    ;;
  esac
  case "$arg" in
  "")
    echo -e "  Charge limit: ${CYAN}$(read_safe "$BAT_LIMIT")%${NC}"
    ;;
  full)
    mkdir -p "$BAT_STATE_DIR" 2>/dev/null
    echo 100 >"$BAT_STATE" 2>/dev/null || true
    apply_bat_limit 100
    ;;
  oneshot | o)
    local cur=$(read_safe "$BAT_LIMIT")
    if [[ "$cur" != "100" ]]; then
      mkdir -p "$BAT_STATE_DIR" 2>/dev/null
      echo "$cur" >"$BAT_STATE" 2>/dev/null || warn "Couldn't save base limit ($cur)"
    fi
    apply_bat_limit 100
    info "Limit reverts to saved value on AC unplug (udev hook) or via 'pwr bat restore'"
    ;;
  install)
    bat_install
    ;;
  uninstall)
    bat_uninstall
    ;;
  restore)
    bat_restore
    ;;
  *)
    [[ "$arg" =~ ^[0-9]+$ ]] && [[ "$arg" -ge 20 ]] && [[ "$arg" -le 100 ]] || {
      echo "Usage: pwr bat [20-100|full|oneshot|o|restore|install|uninstall]"
      exit 1
    }
    mkdir -p "$BAT_STATE_DIR" 2>/dev/null
    echo "$arg" >"$BAT_STATE" 2>/dev/null || true
    apply_bat_limit "$arg"
    ;;
  esac
}

apply_bluetooth() {
  local state="$1"
  if [[ "$state" == "off" ]]; then
    local bt_connected
    bt_connected=$(bluetoothctl devices Connected 2>/dev/null | head -1)
    if [[ -n "$bt_connected" ]]; then
      warn "Bluetooth has connected devices — skipping off"
      bluetoothctl devices Connected 2>/dev/null | while read -r line; do
        printf "    %s\n" "$line"
      done
      return 0
    fi
  fi
  bluetoothctl power "$state" 2>/dev/null >/dev/null && ok "Bluetooth → $state" || warn "Bluetooth → $state failed"
}

# IRQ pinning — hot IRQs → E-cores (lowest max-freq CPUs) so P-cores can sleep deep.

IRQ_PINS=(
  "i915"
  "iwlwifi:default_queue"
  "iwlwifi:queue_1"
)
IRQ_SERVICE="/usr/lib/systemd/system/pwr-irq-pin.service"

# E-cores = CPUs with the lowest max freq (Gracemont on hybrid Intel)
e_core_list() {
  local min_freq="" c f out=""
  min_freq=$(cat /sys/devices/system/cpu/cpu[0-9]*/cpufreq/cpuinfo_max_freq 2>/dev/null | sort -n | head -1) || true
  [[ -n "$min_freq" ]] || return 1
  for c in $(ls -d /sys/devices/system/cpu/cpu[0-9]* 2>/dev/null | grep -oE '[0-9]+$' | sort -n); do
    f=$(cat "/sys/devices/system/cpu/cpu${c}/cpufreq/cpuinfo_max_freq" 2>/dev/null) || continue
    [[ "$f" == "$min_freq" ]] && out+="$c "
  done
  echo "${out% }"
}

# Emits "name irq cur target" per pinned IRQ — single lookup for all status formatters.
irq_pin_state() {
  local cores=() i=0 name irq cur target
  read -ra cores <<<"$(e_core_list)" || true
  for name in "${IRQ_PINS[@]}"; do
    irq=$(awk -v n="$name" '$NF==n{gsub(":","",$1);print $1}' /proc/interrupts | head -1)
    cur="?"
    [[ -n "$irq" ]] && cur=$(read_safe "/proc/irq/$irq/smp_affinity_list")
    target="${cores[$i]}"
    printf '%s %s %s %s\n' "$name" "$irq" "$cur" "$target"
    i=$((i + 1))
  done
}

# Affinity writes can transiently EINVAL right after boot while IRQs settle — retry.
# A missing IRQ name won't fix itself, so fail fast on that.
irq_pin_one() {
  local name="$1" target="$2" irq="" attempt
  for _ in 1 2 3 4 5; do
    irq=$(awk -v n="$name" '$NF==n{gsub(":","",$1);print $1}' /proc/interrupts | head -1)
    [[ -n "$irq" ]] || return 1
    if echo "$target" >"/proc/irq/$irq/smp_affinity_list" 2>/dev/null; then
      return 0
    fi
    sleep 1
  done
  return 1
}

apply_irq_pins() {
  local cores=() i=0 name
  read -ra cores <<<"$(e_core_list)" || true
  ((${#cores[@]} >= 3)) || {
    warn "IRQ pinning skipped — need ≥3 E-cores, found ${#cores[@]}"
    return 0
  }
  for name in "${IRQ_PINS[@]}"; do
    if irq_pin_one "$name" "${cores[$i]}"; then
      ok "IRQ pin: $name → E-core ${cores[$i]}"
    else
      warn "IRQ pin: $name → ${cores[$i]} failed (retry: pwr irq)"
    fi
    i=$((i + 1))
  done
}

cmd_irq_status() {
  local cores=() name irq cur target
  read -ra cores <<<"$(e_core_list)" || true
  echo -e "\n${BOLD}  IRQ Pins${NC}  (E-cores: ${cores[*]:-none})"
  while read -r name irq cur target; do
    target="${target:-none}"
    if [[ "$cur" == "$target" ]]; then
      printf "  %-24s ${GREEN}%s ✓${NC} ${DIM}(irq %s)${NC}\n" "$name" "$cur" "$irq"
    else
      printf "  %-24s ${YELLOW}%s ✗${NC} → want %s ${DIM}(irq %s)${NC}\n" "$name" "$cur" "$target" "$irq"
    fi
  done < <(irq_pin_state)
}

irq_install() {
  local self
  self=$(readlink -f "$0")
  printf '[Unit]\nDescription=Pin hot IRQs to E-cores (pwr)\nAfter=multi-user.target\n\n[Service]\nType=oneshot\nExecStart=%s irq pin\nRemainAfterExit=yes\n\n[Install]\nWantedBy=multi-user.target\n' "$self" >"$IRQ_SERVICE"
  systemctl daemon-reload 2>/dev/null
  systemctl enable --now pwr-irq-pin.service >/dev/null 2>&1 || true
  ok "IRQ pin boot service installed (→ $IRQ_SERVICE)"
}

irq_uninstall() {
  systemctl disable pwr-irq-pin.service >/dev/null 2>&1 || true
  rm -f "$IRQ_SERVICE"
  systemctl daemon-reload 2>/dev/null || true
  ok "IRQ pin boot service removed"
}

cmd_irq() {
  case "${1:-}" in
  "" | pin) apply_irq_pins ;;
  install) irq_install ;;
  uninstall) irq_uninstall ;;
  status | s) cmd_irq_status ;;
  *)
    echo "Usage: pwr irq [pin|install|uninstall|status]"
    exit 1
    ;;
  esac
}

# Status

cmd_status() {
  echo -e "\n${BOLD}GLaDOS Power State${NC}\n"

  hr
  echo -e "${BOLD}  Battery${NC}"
  local capacity=$(read_safe /sys/class/power_supply/BAT0/capacity)
  local bat_status=$(read_safe /sys/class/power_supply/BAT0/status)
  local power_now=$(read_safe /sys/class/power_supply/BAT0/power_now)
  local power_w=$(to_watts "$power_now")
  local voltage=$(read_safe /sys/class/power_supply/BAT0/voltage_now)
  local voltage_v=$(echo "scale=2; $voltage / 1000000" | bc 2>/dev/null || echo "?")
  printf "  %-15s ${CYAN}%s%%${NC}\n" "Capacity:" "$capacity"
  printf "  %-15s ${CYAN}%s${NC}\n" "Status:" "$bat_status"
  printf "  %-15s ${CYAN}%sW${NC}\n" "Power draw:" "$power_w"
  printf "  %-15s ${CYAN}%sV${NC}\n" "Voltage:" "$voltage_v"
  echo ""

  hr
  echo -e "${BOLD}  CPU${NC}"
  local gov=$(read_safe "$CPU_GOV")
  local epp=$(read_safe "$CPU_EPP")
  local cur=$(to_mhz "$(read_safe "$CPU_FREQ_CUR")")
  local turbo=$(turbo_state)
  local pp=$(read_safe "$PLATFORM_PROFILE")
  local bat_limit=$(read_safe "$BAT_LIMIT")
  printf "  %-15s ${CYAN}%s${NC}\n" "Governor:" "$gov"
  printf "  %-15s ${CYAN}%s${NC}\n" "EPP:" "$epp"
  printf "  %-15s ${CYAN}%s${NC}\n" "Turbo:" "$turbo"
  printf "  %-15s ${CYAN}%s${NC}\n" "Platform:" "$pp"
  printf "  %-15s ${CYAN}%s%%${NC}\n" "Charge limit:" "$bat_limit"
  printf "  %-15s ${CYAN}ac=%s dc=%s${NC} ${DIM}(hook %s)${NC}\n" "PP auto:" "$(read_safe "$PP_AC")" "$(read_safe "$PP_DC")" "$(pp_rule_state)"
  printf "  %-15s ${CYAN}%s MHz${NC}\n" "Frequency:" "$cur"
  find_rapl
  if ((${#RAPL_CONSTRAINTS[@]})); then
    local e pl path v zone
    for e in "${RAPL_CONSTRAINTS[@]}"; do
      read -r path pl <<<"$e"
      zone=${path#/sys/class/powercap/}
      zone=${zone%%/*}
      v=$(to_watts "$(read_safe "$path")")
      printf "  %-15s ${CYAN}%sW${NC} ${DIM}(%s)${NC}\n" "${pl}:" "$v" "$zone"
    done
  else
    printf "  %-15s ${CYAN}%s${NC}\n" "RAPL:" "unsupported"
  fi
  echo ""

  hr
  echo -e "${BOLD}  GPU${NC}"
  local gpu_cur gpu_max gpu_min
  if find_gpu; then
    gpu_cur=$(read_safe "$GPU_CUR")
    gpu_max=$(read_safe "$GPU_MAX")
    gpu_min=$(read_safe "$GPU_MIN")
    printf "  %-15s ${CYAN}%s MHz${NC}\n" "Current:" "$gpu_cur"
    printf "  %-15s ${CYAN}%s / %s MHz${NC}\n" "Min/Max:" "$gpu_min" "$gpu_max"
  else
    echo -e "  ${YELLOW}no Intel GT card found${NC}"
  fi
  echo ""

  hr
  echo -e "${BOLD}  Peripherals${NC}"
  local aspm=$(read_safe "$PCIE_ASPM")
  local sound=$(read_safe "$SOUND_PM")
  local wifi=$(wifi_power_state)
  local bt=$(bluetoothctl show 2>/dev/null | grep "Powered:" | awk '{print $2}' || echo "?")
  printf "  %-15s ${CYAN}%s${NC}\n" "PCIe ASPM:" "$aspm"
  printf "  %-15s ${CYAN}%s${NC}\n" "WiFi PM:" "$wifi"
  printf "  %-15s ${CYAN}%s${NC}\n" "Sound PM:" "$sound"
  printf "  %-15s ${CYAN}%s${NC}\n" "Bluetooth:" "$bt"
  echo ""

  hr
  echo -e "${BOLD}  IRQ Pins${NC}"
  local name irq cur target
  while read -r name irq cur target; do
    target="${target:-none}"
    if [[ "$cur" == "$target" ]]; then
      printf "  %-22s ${GREEN}%s ✓${NC}\n" "$name" "$cur"
    else
      printf "  %-22s ${YELLOW}%s ✗${NC} ${DIM}(want %s)${NC}\n" "$name" "$cur" "$target"
    fi
  done < <(irq_pin_state)
  echo ""
}

# List

cmd_list() {
  echo -e "\n${BOLD}Options${NC}\n"

  # RAPL
  find_rapl
  if ((${#RAPL_CONSTRAINTS[@]})); then
    local e pl path v max line=""
    for e in "${RAPL_CONSTRAINTS[@]}"; do
      read -r path pl <<<"$e"
      v=$(to_watts "$(read_safe "$path")")
      max=$(to_watts "$(read_safe "${path%_power_limit_uw}_max_power_uw")")
      line+="${pl}=${v}W "
      [[ "$max" != "?" ]] && line+="[max ${max}W] "
    done
    printf "  ${BOLD}rapl${NC}      ${CYAN}%s${NC}\n" "${line% }"
  else
    printf "  ${BOLD}rapl${NC}      ${DIM}unsupported${NC}\n"
  fi

  # Turbo
  local turbo=$(turbo_state)
  if [[ "$turbo" == "on" ]]; then
    printf "  ${BOLD}turbo${NC}     ${GREEN}on${NC} ${DIM}off${NC}\n"
  else
    printf "  ${BOLD}turbo${NC}     ${DIM}on${NC} ${GREEN}off${NC}\n"
  fi

  # Platform profile
  menu_highlight "pp" "$(read_safe "$PLATFORM_PROFILE")" $(cat "$PLATFORM_PROFILE_AVAIL" 2>/dev/null)

  # Governor
  menu_highlight "gov" "$(read_safe "$CPU_GOV")" $(cat "$CPU_GOV_AVAIL" 2>/dev/null)

  # EPP
  menu_highlight "epp" "$(read_safe "$CPU_EPP")" $(cat "$CPU_EPP_AVAIL" 2>/dev/null)

  # GPU
  local gpu_cur gpu_max gpu_min
  if find_gpu; then
    gpu_cur=$(read_safe "$GPU_CUR")
    gpu_max=$(read_safe "$GPU_MAX")
    gpu_min=$(read_safe "$GPU_MIN")
    printf "  ${BOLD}gpu${NC}       ${CYAN}${gpu_cur}${NC} MHz (${gpu_min}-${gpu_max})\n"
  else
    printf "  ${BOLD}gpu${NC}       ${DIM}not found${NC}\n"
  fi

  # ASPM (sysfs marks the active mode as [bracketed])
  local aspm=$(read_safe "$PCIE_ASPM")
  local aspm_active
  aspm_active=$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' <<<"$aspm")
  [[ -n "$aspm_active" ]] || aspm_active="$aspm"
  menu_highlight "aspm" "$aspm_active" performance powersave powersupersave

  # WiFi
  local wifi=$(wifi_power_state)
  if [[ "$wifi" == "on" ]]; then
    printf "  ${BOLD}wifi${NC}      ${GREEN}on${NC} ${DIM}off${NC}\n"
  else
    printf "  ${BOLD}wifi${NC}      ${DIM}on${NC} ${GREEN}off${NC}\n"
  fi

  # Sound
  local sound=$(read_safe "$SOUND_PM")
  printf "  ${BOLD}sound${NC}     ${CYAN}${sound}${NC}/10\n"

  # IRQ pins
  local name irq cur target disp line=""
  while read -r name irq cur target; do
    target="${target:-?}"
    case "$name" in
    iwlwifi:default_queue) disp="wifi:defq" ;;
    iwlwifi:queue_1) disp="wifi:q1" ;;
    *) disp="$name" ;;
    esac
    if [[ "$cur" == "$target" ]]; then
      line+="${DIM}${disp}${NC}→${GREEN}${cur} ✓${NC} "
    else
      line+="${DIM}${disp}${NC}→${YELLOW}${cur} ✗${NC} "
    fi
  done < <(irq_pin_state)
  printf "  ${BOLD}irq${NC}       %b${DIM}(pin|install|uninstall|status)${NC}\n" "$line"
  echo ""
}

# Levels

level_0() {
  echo -e "\n${BOLD}${GREEN}LEVEL 0: Maximum Battery${NC}\n"
  apply_platform_profile "quiet"
  apply_rapl 15 25
  apply_governor "powersave"
  apply_epp "power"
  apply_turbo "off"
  apply_pcie_aspm "powersupersave"
  apply_wifi_power "on"
  apply_sound_pm "10"
  apply_gpu "1500"
  apply_bluetooth "off"
  apply_irq_pins
}

level_g() {
  echo -e "\n${BOLD}${GREEN}LEVEL G${NC}\n"
  apply_rapl 25 35
  apply_governor "powersave"
  apply_epp "power"
  apply_turbo "off"
}

level_1() {
  echo -e "\n${BOLD}${CYAN}LEVEL 1: Light Use${NC}\n"
  apply_platform_profile "quiet"
  apply_rapl 15 25
  apply_governor "powersave"
  apply_epp "balance_power"
  apply_pcie_aspm "powersupersave"
  apply_wifi_power "on"
  apply_sound_pm "10"
  apply_gpu "1800"
}

level_2() {
  echo -e "\n${BOLD}${YELLOW}LEVEL 2: Balanced${NC}\n"
  apply_platform_profile "balanced"
  apply_rapl 25 35
  apply_governor "powersave"
  apply_epp "balance_performance"
  apply_pcie_aspm "powersave"
  apply_wifi_power "off"
  apply_sound_pm "10"
  apply_gpu "2000"
  apply_bluetooth "on"
}

level_3() {
  echo -e "\n${BOLD}${RED}LEVEL 3: Performance${NC}\n"
  apply_platform_profile "performance"
  apply_rapl 45 65
  apply_governor "powersave"
  apply_epp "performance"
  apply_pcie_aspm "performance"
  apply_wifi_power "off"
  apply_sound_pm "0"
  apply_gpu "2200"
  apply_bluetooth "on"
}

# Usage

cmd_usage() {
  printf "\n${BOLD}pwr — power mode controller${NC}\n\n"
  printf "Levels:\n"
  printf "  ${GREEN}0${NC}  Maximum battery\n"
  printf "  ${CYAN}1${NC}  Light use\n"
  printf "  ${YELLOW}2${NC}  Balanced\n"
  printf "  ${RED}3${NC}  Performance\n"
  printf "\nIndividual:\n"
  printf "  rapl <pl1> <pl2>   RAPL power limits (watts, auto-clamped)\n"
  printf "  turbo <on|off>     Turbo boost (intel no_turbo / amd boost)\n"
  printf "  pp <profile>       ACPI platform profile\n"
  printf "  pp ac|dc <prof>    Auto profile on AC/battery (installs udev hook)\n"
  printf "  pp auto|status [install|uninstall]  Show/manage pp hook\n"
  printf "  bat [20-100|full|oneshot|o|restore|install|uninstall]  Charge limit + udev hook\n"
  printf "  gpu <freq>         Intel GT max frequency (MHz, auto-detected card)\n"
  printf "  epp <pref>         Energy performance preference\n"
  printf "  gov <governor>     CPU frequency governor\n"
  printf "  aspm <mode>        PCIe ASPM mode\n"
  printf "  wifi <on|off>      WiFi power save\n"
  printf "  sound <seconds>    HDA sound power save timeout (0=off)\n"
  printf "  bt <on|off>        Bluetooth power\n"
  printf "  irq [pin|install|uninstall|status]  Pin hot IRQs to E-cores (+boot service)\n"
  printf "\nInfo:\n"
  printf "  status, s          Current power state\n"
  printf "  list, ls           Available options\n"
}

# Main

case "${1:-}" in
g) level_g ;;
0 | max | saver) level_0 ;;
1 | light) level_1 ;;
2 | balanced | bal | b) level_2 ;;
3 | performance | perf | p) level_3 ;;

rapl)
  [[ "${2:-}" =~ ^[0-9]+$ && "${3:-}" =~ ^[0-9]+$ ]] || {
    echo "Usage: pwr rapl <pl1_watts> <pl2_watts> (integers)"
    exit 1
  }
  apply_rapl "$2" "$3"
  ;;
gpu)
  [[ "${2:-}" =~ ^[0-9]+$ ]] || {
    echo "Usage: pwr gpu <freq_mhz> (integer)"
    exit 1
  }
  apply_gpu "$2"
  ;;
epp)
  [[ -z "${2:-}" ]] && {
    echo "Usage: pwr epp <preference>"
    exit 1
  }
  apply_epp "$2"
  ;;
gov)
  [[ -z "${2:-}" ]] && {
    echo "Usage: pwr gov <governor>"
    exit 1
  }
  apply_governor "$2"
  ;;
aspm)
  [[ -z "${2:-}" ]] && {
    echo "Usage: pwr aspm <mode>"
    exit 1
  }
  apply_pcie_aspm "$2"
  ;;
wifi)
  [[ -z "${2:-}" ]] && {
    echo "Usage: pwr wifi <on|off>"
    exit 1
  }
  apply_wifi_power "$2"
  ;;
sound)
  [[ "${2:-}" =~ ^[0-9]+$ ]] || {
    echo "Usage: pwr sound <seconds>"
    exit 1
  }
  apply_sound_pm "$2"
  ;;
bt)
  [[ -z "${2:-}" ]] && {
    echo "Usage: pwr bt <on|off>"
    exit 1
  }
  apply_bluetooth "$2"
  ;;
bat | battery)
  cmd_bat "${2:-}"
  ;;
pp)
  cmd_pp "${2:-}" "${3:-}"
  ;;
pp-auto)
  cmd_pp_auto "${2:-}"
  ;;
turbo)
  [[ -z "${2:-}" ]] && {
    echo "Usage: pwr turbo <on|off>"
    exit 1
  }
  apply_turbo "$2"
  ;;

irq)
  cmd_irq "${2:-}"
  ;;
status | s) cmd_status ;;
list | ls | l) cmd_list ;;
*) cmd_usage ;;
esac
